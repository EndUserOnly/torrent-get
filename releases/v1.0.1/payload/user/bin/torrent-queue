#!/usr/bin/env python3
"""Compatibility entry point for the authoritative torrent management lifecycle."""
import os
import sys
from pathlib import Path

if __name__ == '__main__':
    args=sys.argv[1:] or ['list']
    if args[0]=='stop':
        args[0]='pause'
    executable=Path.home()/'.local/bin/torrent-mgmnt'
    os.execv(str(executable),[str(executable),*args])
