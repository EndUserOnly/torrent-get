def _parse_numeric_selection(raw):
    """Parse comma/whitespace-delimited numbers and inclusive ranges."""
    text=(
        " ".join(str(value) for value in raw)
        if isinstance(raw,(list,tuple))
        else str(raw)
    )
    text=re.sub(r'(?<=\d)\s*-\s*(?=\d)', '-', text)
    selected=[]

    for token in text.replace(',', ' ').split():
        match=re.fullmatch(r'([0-9]+)(?:-([0-9]+))?', token)

        if not match:
            raise ValueError(f"invalid selection: {token}")

        first=int(match.group(1))
        last=int(match.group(2) or first)

        if first<1 or last<first:
            raise ValueError(f"invalid selection: {token}")

        selected.extend(range(first,last+1))

    if not selected:
        raise ValueError("no selections")

    return list(dict.fromkeys(selected))


# torrent-get operator configuration.
#
# Configuration is owned by torrent-mgmnt.  torrent-get consumes
# the resulting setting silently when submitting new jobs.
TORRENT_GET_CONFIG=(
    Path.home()
    / ".local"
    / "share"
    / "torrent-get"
    / "config.json"
)

def _load_torrent_get_config():
    import json

    try:
        data=json.loads(TORRENT_GET_CONFIG.read_text())
        if isinstance(data,dict):
            return data
    except Exception:
        pass

    return {}

def _write_torrent_get_config(data):
    import json
    import os
    import tempfile

    parent=TORRENT_GET_CONFIG.parent
    parent.mkdir(
        mode=0o700,
        parents=True,
        exist_ok=True,
    )

    try:
        parent.chmod(0o700)
    except OSError:
        pass

    fd,tmp=tempfile.mkstemp(
        prefix=".config.",
        suffix=".tmp",
        dir=str(parent),
    )

    tmp_path=Path(tmp)

    try:
        with os.fdopen(fd,"w",encoding="utf-8") as handle:
            json.dump(
                data,
                handle,
                indent=2,
                sort_keys=True,
            )
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())

        os.chmod(tmp_path,0o600)
        os.replace(
            tmp_path,
            TORRENT_GET_CONFIG,
        )
        os.chmod(
            TORRENT_GET_CONFIG,
            0o600,
        )

    finally:
        try:
            tmp_path.unlink()
        except FileNotFoundError:
            pass

def _configured_download_folder():
    data=_load_torrent_get_config()

    raw=str(
        data.get("download_folder","")
    ).strip()

    if raw:
        path=Path(raw).expanduser()

        if path.is_absolute() and path.is_dir():
            return path

    return Path.home() / "Downloads"

def configure_download_folder():
    current=_configured_download_folder()

    print()
    print("Current download folder:")
    print(f"  {current}")
    print()

    while True:
        try:
            raw=input(
                "Enter full path (Enter=keep current, q=cancel): "
            ).strip()
        except (EOFError,KeyboardInterrupt):
            print()
            print("Configuration cancelled.")
            return

        if not raw:
            print()
            print("Download folder unchanged:")
            print(f"  {current}")
            return

        if raw.casefold()=="q":
            print()
            print("Configuration cancelled.")
            return

        selected=Path(raw).expanduser()

        if selected.is_absolute() and selected.is_dir():
            break

        print()
        print(
            "Download folder does not exist or is not a directory."
        )
        print()

    data=_load_torrent_get_config()
    data["download_folder"]=str(selected)
    _write_torrent_get_config(data)

    print()
    print("Download folder updated:")
    print(f"  {selected}")

def ensure_dirs():
 STATE_DIR.mkdir(parents=True,exist_ok=True); LOG_DIR.mkdir(parents=True,exist_ok=True)

def boot_id():
 try:return Path('/proc/sys/kernel/random/boot_id').read_text().strip()
 except OSError:return ''

def durable_json_write(path,data):
 path=Path(path); tmp=path.with_name(path.name+f'.tmp.{os.getpid()}'); previous=path.with_name(path.name+'.prev')
 payload=(json.dumps(data,indent=2,sort_keys=True)+'\n').encode()
 fd=os.open(tmp,os.O_WRONLY|os.O_CREAT|os.O_TRUNC,0o600)
 try:
  offset=0
  while offset<len(payload):offset+=os.write(fd,payload[offset:])
  os.fsync(fd)
 finally:os.close(fd)
 had_current=path.exists()
 if had_current:os.replace(path,previous)
 try:os.replace(tmp,path)
 except BaseException:
  if had_current and previous.exists():os.replace(previous,path)
  raise
 dirfd=os.open(path.parent,os.O_RDONLY|os.O_DIRECTORY)
 try:os.fsync(dirfd)
 finally:os.close(dirfd)
 os.chmod(path,0o600)

def load_state():
 empty={'next_id':1,'jobs':[]}
 if not STATE_FILE.exists():return empty
 try:return json.loads(STATE_FILE.read_text())
 except Exception as primary_error:
  previous=STATE_FILE.with_name(STATE_FILE.name+'.prev')
  try:return json.loads(previous.read_text())
  except Exception:raise RuntimeError(f'Queue state is unreadable: {primary_error}')

class locked_state:
 def __enter__(self):
  ensure_dirs(); self.fp=open(LOCK_FILE,'a+'); fcntl.flock(self.fp.fileno(),fcntl.LOCK_EX)
  self.data=load_state()
  return self.data
 def __exit__(self,t,v,tb):
  if t is None:
   durable_json_write(STATE_FILE,self.data)
  fcntl.flock(self.fp.fileno(),fcntl.LOCK_UN); self.fp.close()

def magnet_fields(m):
 q=parse_qs(urlparse(m).query); dn=(q.get('dn') or ['Unnamed torrent'])[0]; xt=(q.get('xt') or [''])[0]
 return dn,xt.rsplit(':',1)[-1].upper() if xt else ''


def source_fields(source):
 source=str(source or "").strip()

 if not source.startswith("magnet:?"):
  raise SystemExit(
   "Rejected: production torrent import accepts magnet URIs only."
  )

 name,ih=magnet_fields(source)

 return source,"magnet",name,ih


def proc_start(pid):
 try:return int(Path(f'/proc/{pid}/stat').read_text().split()[21])
 except:return None

def proc_argv(pid):
 try:return [x.decode(errors='replace') for x in Path(f'/proc/{pid}/cmdline').read_bytes().split(b'\0') if x]
 except:return []

def cmdline(pid):
 return ' '.join(proc_argv(pid))

def alive(j):
 if j.get('boot_id') and j.get('boot_id')!=boot_id():return False
 pid=int(j.get('pid') or 0)
 ticks=proc_start(pid)

 if (
  pid<=0
  or ticks is None
  or ticks!=j.get('proc_start_ticks')
 ):
  return False

 argv=proc_argv(pid)

 if not argv:
  return False

 executable=Path(argv[0]).name

 if "torrent-worker-posix" not in executable:
  return False

 nonce=str(j.get('worker_nonce') or '')
 if nonce and (len(argv)<6 or argv[5]!=nonce):
  return False

 source=str(
  j.get("source")
  or j.get("magnet")
  or ""
 ).strip()

 if not source:
  return True

 return (
  len(argv)>=2
  and argv[1]==source
 )

def safe_target(j):
 p=Path(j['expected_payload']).expanduser(); dest=Path(j['save_path']).expanduser().resolve()
 try:par=p.parent.resolve()
 except:return None
 return p if par==dest or dest in par.parents else None

def worker_orphaned(j):
 logp=Path(j.get('log_path') or '')
 if not logp.exists():return False
 try:
  with logp.open('rb') as f:
   f.seek(0,2); size=f.tell(); f.seek(max(0,size-8192))
   tail=f.read().decode(errors='replace')
  return 'ORPHANED: metadata unavailable after 5 minutes.' in tail
 except OSError:return False

def checkpoint_status(j):
 path=RESUME_DIR/f"job-{int(j['id'])}.fastresume"
 candidates=[p for p in (path,path.with_name(path.name+'.prev')) if p.is_file()]
 usable=[p for p in candidates if p.stat().st_size>0]
 if not usable:return False,None,None
 generation=max(p.stat().st_mtime_ns for p in usable)
 return True,int(generation//1_000_000_000),generation

def refresh(j):
 recorded_boot=str(j.get('boot_id') or '')
 a=alive(j); p=safe_target(j); ex=bool(p and p.exists())
 if a and not j.get('source'):
  argv=proc_argv(int(j.get('pid') or 0))

  if len(argv)>=2:
   candidate=str(argv[1]).strip()

   if candidate.startswith('magnet:?'):
    j['source']=candidate

    if not j.get('magnet'):
     j['magnet']=candidate
 if ex:j['payload_seen']=True
 checkpoint_ok,checkpoint_at,checkpoint_generation=checkpoint_status(j)
 j['checkpoint_valid']=checkpoint_ok
 j['checkpoint_at']=checkpoint_at
 j['checkpoint_generation']=checkpoint_generation
 if a:
  j['state']='MISSING' if j.get('payload_seen') and not ex else ('PAUSING' if j.get('state')=='PAUSING' else 'RUNNING')
 else:
  prior=j.get('state')
  if prior=='PAUSING':j['state']='PAUSED' if checkpoint_ok else 'RECOVERABLE'
  elif prior in {'RUNNING','MISSING'}:
   j['state']='ORPHANED' if worker_orphaned(j) else 'RECOVERABLE'
   if j['state']=='RECOVERABLE':
    j['recovery_reason']='previous boot ended' if recorded_boot and recorded_boot!=boot_id() else 'worker ownership lost'
  else:j['state']=prior or 'EXITED'

 # Dead worker identity must not survive reconciliation.
 if j.get('state') in {'ORPHANED','RECOVERABLE','PAUSED'}:
  j['pid']=None
  j['proc_start_ticks']=None
 j['last_checked']=int(time.time())

def get_job(s,jid):return next((j for j in s['jobs'] if int(j['id'])==jid),None)

def human_size(n):
 if n is None:return '--'
 v=float(max(0,n)); u=['B','KiB','MiB','GiB','TiB']; i=0
 while v>=1024 and i<len(u)-1:v/=1024;i+=1
 return f'{v:.0f} {u[i]}' if i==0 else f'{v:.1f} {u[i]}'


def display_pid(j):
    # PID may remain in queue state for historical/recovery identity.
    # The operator plane displays only a currently live RUNNING PID.
    if j.get("state") != "RUNNING":
        return "--"

    pid=j.get("pid")

    if not pid:
        return "--"

    try:
        os.kill(int(pid),0)
    except (ProcessLookupError,ValueError,TypeError):
        return "--"
    except PermissionError:
        pass

    return str(pid)


def activity(st,j):
 if not alive(j):return '--'
 if not st:return 'STARTING'
 if not st['metadata']:return 'METADATA'

 p=st['progress']

 # Activity is a live-work statement, not a torrent-rate guess.
 #
 # Ask the same worker PEERS interface used by torrent-peers.
 # A torrent is DOWNLOADING only when at least one peer currently
 # reports positive payload receive work; likewise for upload.
 #
 # PEER records are tab-separated. Rather than depending on client
 # names, IP versions, or display formatting, identify numeric rate
 # fields from the worker's PEER record itself.
 raw=socket_query(j,'PEERS',timeout=1.0)

 receiving=False
 sending=False
 peer_truth=bool(
  raw
  and raw.splitlines()
  and raw.splitlines()[0].startswith("PEERS\t")
 )

 if raw:
  for line in raw.splitlines():
   x=line.split('\t')

   if not x or x[0]!='PEER':
    continue

   # The worker PEERS interface currently carries its live payload
   # rates as integer fields. Use the same two rate positions consumed
   # by torrent-peers: down then up.
   #
   # We deliberately fail back to STATUS if the record shape cannot
   # be established, rather than inventing activity.
   try:
    peer_down=int(x[4])
    peer_up=int(x[5])
   except (IndexError,TypeError,ValueError):
    continue

   peer_truth=True

   if peer_down>0:
    receiving=True

   if peer_up>0:
    sending=True

 if p>=0.9995:
  if peer_truth:
   return 'UPLOADING' if sending else 'COMPLETE'
  return 'SEEDING' if st['up']>0 else 'COMPLETE'

 if peer_truth:
  if receiving and sending:return 'TRANSFER'
  if receiving:return 'DOWNLOADING'
  if sending:return 'UPLOADING'
  return 'IDLE'

 # PEERS unavailable: retain historical STATUS behavior rather than
 # falsely converting an unavailable live interface to IDLE.
 down=st['down']; up=st['up']
 if down>0 and up>0:return 'TRANSFER'
 if down>0:return 'DOWNLOADING'
 if up>0:return 'UPLOADING'
 return 'IDLE'

def socket_query(j,command,timeout=3.0):
 p=Path(f"/run/user/{os.getuid()}/torrent-control.sock")
 try:
  with socket.socket(socket.AF_UNIX,socket.SOCK_STREAM) as s:
   s.settimeout(timeout+1.0); s.connect(str(p)); s.sendall((json.dumps({
    'job_id':int(j['id']),'pid':int(j.get('pid') or 0),
    'command':command,'timeout':timeout
   },separators=(',',':'))+'\n').encode()); raw=b''
   while True:
    b=s.recv(65536)
    if not b:break
    raw+=b
   return raw.decode(errors='replace')
 except:return None

def live_status(j):
 raw=socket_query(j,'STATUS')
 if not raw:return None
 x=raw.strip().split('\t')
 try:
  if len(x)>=9 and x[0]=='STATUS':
   return {'metadata':x[1]=='1','progress':float(x[2]),'size':int(x[3]),'down':int(x[4]),'up':int(x[5]),'peers':int(x[6]),'seeds':int(x[7]),'name':x[8]}
 except:pass
 return None

def systemd_main_pid(unit):
 try:
  out=subprocess.check_output(['systemctl','--user','show',unit,'-p','MainPID','--value'],text=True,stderr=subprocess.DEVNULL).strip(); pid=int(out or 0)
  return pid if pid>0 else None
 except:return None


def retire_metadata_approval(job):
    """
    Retire Gatekeeper approval state belonging to this queue job.

    Queue infohash is authoritative.
    No title-specific matching.
    """
    raw=str(
        job.get("infohash")
        or ""
    ).strip().lower()

    if not raw:
        return 0

    store=ApprovalStore(
        METADATA_APPROVAL_ROOT
    )

    if not store.root.exists():
        return 0

    removed=0

    for record in store.list_records():
        identity=record.identity

        stored=str(
            identity.infohash
        ).strip().lower()

        parts={
            item.strip().lower()
            for item in stored.split("|")
            if item.strip()
        }

        candidates=set(parts)

        for item in parts:
            if ":" in item:
                candidates.add(
                    item.split(":",1)[1]
                )

        if raw not in candidates:
            continue

        if store.invalidate(identity):
            removed+=1

    return removed

def launch_worker(j, torrent_source, save, logp, unit):
 torrent_source=str(torrent_source)

 if network_paused():
  raise RuntimeError(
   "Global torrent network is PAUSED; worker admission blocked."
  )
 runtime=Path(f"/run/user/{os.getuid()}/torrent-get")
 runtime.mkdir(mode=0o700,parents=True,exist_ok=True)
 runtime.chmod(0o700)

 # Production Gatekeeper runtime.
 #
 # This directory is intentionally ephemeral.  It contains only the
 # executable approval stack required by the sandboxed worker.  It is
 # rebuilt from canonical production components and contains no
 # diagnostic-history state.
 security_runtime=runtime/"security"
 security_runtime.mkdir(mode=0o700,parents=True,exist_ok=True)
 security_runtime.chmod(0o700)

 # Persistent approval records are not runtime history.
 # They are the security authority needed to recognize an exact
 # previously-approved metadata identity and manifest.
 METADATA_APPROVAL_ROOT.mkdir(
  mode=0o700,
  parents=True,
  exist_ok=True
 )
 METADATA_APPROVAL_ROOT.chmod(0o700)

 approval_runtime=runtime/"metadata-approvals"
 approval_runtime.mkdir(
  mode=0o700,
  parents=True,
  exist_ok=True
 )
 approval_runtime.chmod(0o700)

 security_components={
  SECURITY_LIB/"approval_store.py":"approval_store.py",
  SECURITY_LIB/"gate_store_connector.py":"gate_store_connector.py",
  SECURITY_LIB/"gatekeeper_diagnostic_connector.py":"gatekeeper_diagnostic_connector.py",
  HOME/".local/libexec/torrent-approval-bridge":"torrent-approval-bridge",
 }

 for source,name in security_components.items():
  if not source.is_file():
   raise RuntimeError(
    f"Gatekeeper production component missing: {source}"
   )

  target=security_runtime/name
  shutil.copy2(source,target)

  if name=="torrent-approval-bridge":
   target.chmod(0o700)
  else:
   target.chmod(0o600)

 RESUME_DIR.mkdir(mode=0o700,parents=True,exist_ok=True)
 RESUME_DIR.chmod(0o700)

 resume_file=RESUME_DIR/f"job-{int(j['id'])}.fastresume"
 worker_nonce=uuid.uuid4().hex

 if not torrent_source.startswith("magnet:?"):
  raise RuntimeError(
   "Production worker accepts magnet URIs only."
  )

 cmd=[
  'systemd-run','--user','--quiet','--collect','--service-type=exec','--slice=torrent-get.slice',f'--unit={unit}',
  '--property=NoNewPrivileges=yes','--property=PrivateTmp=yes','--property=PrivateDevices=yes','--property=ProtectSystem=strict','--property=ProtectHome=tmpfs',
  '--property=ProtectControlGroups=yes','--property=ProtectKernelModules=yes','--property=ProtectKernelTunables=yes','--property=ProtectKernelLogs=yes','--property=RestrictSUIDSGID=yes','--property=LockPersonality=yes',
  '--property=SystemCallFilter=~@mount @swap @reboot @raw-io @module @obsolete @debug @cpu-emulation',
  '--property=SystemCallErrorNumber=EPERM','--property=SystemCallArchitectures=native',
  '--property=Restart=no','--property=KillMode=control-group','--property=TimeoutStopSec=20s','--property=SendSIGKILL=yes',
  f'--property=MemoryHigh={MEMORY_HIGH}',f'--property=MemoryMax={MEMORY_MAX}',f'--property=TasksMax={TASKS_MAX}',f'--property=LimitNOFILE={NOFILE}',
  f'--property=BindReadOnlyPaths={WORKER}',f'--property=BindPaths={save}',f'--property=BindPaths={runtime}',f'--property=BindPaths={METADATA_APPROVAL_ROOT}:{approval_runtime}',f'--property=BindPaths={RESUME_DIR}',
  f'--property=ReadWritePaths={save}',f'--property=ReadWritePaths={runtime}',f'--property=ReadWritePaths={RESUME_DIR}',
  f'--property=StandardOutput=append:{logp}',f'--property=StandardError=append:{logp}',
  str(ENV_BIN),'-i','PATH=/usr/bin:/bin','HOME=/nonexistent','LANG=C',
  str(WORKER),torrent_source,str(save),str(int(j['id'])),str(resume_file),worker_nonce
 ]
 r=subprocess.run(cmd,stdin=subprocess.DEVNULL,stdout=subprocess.DEVNULL,stderr=subprocess.PIPE,text=True)
 if r.returncode!=0:raise SystemExit(f'Unable to launch sandboxed worker: {r.stderr.strip() or "systemd-run failed"}')
 pid=None
 for _ in range(100):
  pid=systemd_main_pid(unit)
  if pid:break
  time.sleep(.02)
 if not pid:
  subprocess.run(['systemctl','--user','stop',unit],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
  raise SystemExit('Sandboxed worker launched but MainPID could not be resolved.')
 j['pid']=pid; j['proc_start_ticks']=proc_start(pid); j['state']='RUNNING'; j['submitted_at']=int(time.time()); j['systemd_unit']=unit; j['sandbox']='systemd-stage1'; j['priority_applied_pid']=None
 checkpoint_valid,checkpoint_at,checkpoint_generation=checkpoint_status(j)
 j['boot_id']=boot_id(); j['worker_nonce']=worker_nonce; j['checkpoint_valid']=checkpoint_valid; j['checkpoint_at']=checkpoint_at; j['checkpoint_generation']=checkpoint_generation
 j['limits']={'memory_high':MEMORY_HIGH,'memory_max':MEMORY_MAX,'tasks_max':TASKS_MAX,'nofile':NOFILE}
 return pid

def submit(source,save,origin=None):
 if not WORKER.exists():
  raise SystemExit(
   f'Queue worker missing: {WORKER}'
  )

 source,source_type,name,ih=source_fields(source)

 save=save.expanduser().resolve()
 save.mkdir(parents=True,exist_ok=True)

 candidate_ih=str(ih or "").strip().lower()

 if not candidate_ih:
  raise SystemExit(
   "Rejected: torrent infohash unavailable."
  )

 # Duplicate detection and job-ID allocation share the same
 # queue lock. A second submission therefore cannot race past
 # an identical first submission.
 with locked_state() as s:
  for existing in s.get('jobs',[]):
   existing_ih=str(
    existing.get('infohash') or ""
   ).strip().lower()

   if (
    existing_ih
    and existing_ih == candidate_ih
   ):
    existing_id=int(
     existing.get('id',0) or 0
    )

    raise SystemExit(
     f"Already active as job [{existing_id}]."
    )

  jid=int(s.get('next_id',1))
  s['next_id']=jid+1

  logp=LOG_DIR/f'job-{jid}.log'
  unit=f'torrent-worker-{jid}.service'
  expected=save/name

  # A newly allocated queue identity cannot inherit recovery
  # state from any previous lifecycle.
  stale_resume=RESUME_DIR/f"job-{jid}.fastresume"

  for stale_generation in (stale_resume,stale_resume.with_name(stale_resume.name+'.prev')):
   try:
    stale_generation.unlink()
   except FileNotFoundError:
    pass
   except OSError as exc:
    raise RuntimeError(
     f"Unable to clear stale fast-resume for new job [{jid}]: {exc}"
    )

  j={
   'id':jid,
   'name':name,
   'infohash':ih,
   'source':source,
   'source_type':source_type,
   'origin':str(origin or '...'),

   # Preserve the legacy field for existing consumers.
   # Native torrent jobs deliberately have no magnet.
   'magnet':(
    source
    if source_type=="magnet"
    else None
   ),

   'save_path':str(save),
   'expected_payload':str(expected),
   'payload_seen':expected.exists(),
   'log_path':str(logp),
   'restart_count':0,
  }

  launch_worker(
   j,
   source,
   save,
   logp,
   unit
  )

  s['jobs'].append(j)

 print(f'Request submitted to queue. Job [{jid}].')

def resume(jid):
 if not WORKER.exists():raise SystemExit(f'Queue worker missing: {WORKER}')
 with locked_state() as s:
  j=get_job(s,jid)
  if not j:raise SystemExit(f'Unknown queue job: {jid}')
  refresh(j)
  if j['state'] in {'RUNNING','MISSING','STOPPING'}:raise SystemExit(f"Job [{jid}] is already active (state: {j['state']}).")
  source=(
   j.get('source')
   or j.get('magnet')
  )

  if not source:
   raise SystemExit(
    f'Job [{jid}] has no persisted magnet source '
    'and cannot be resumed.'
   )

  if not str(source).startswith("magnet:?"):
   raise SystemExit(
    f'Job [{jid}] uses an unsupported legacy non-magnet source.'
   )

  # Migrate an old magnet queue record when it is first resumed.
  if not j.get('source'):
   j['source']=source
   j['source_type']='magnet'
  save=Path(j['save_path']).expanduser().resolve(); save.mkdir(parents=True,exist_ok=True); logp=Path(j['log_path']); unit=f'torrent-worker-{jid}.service'
  subprocess.run(['systemctl','--user','reset-failed',unit],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
  j['restart_count']=int(j.get('restart_count',0))+1; j['resumed_at']=int(time.time())
  launch_worker(j,source,save,logp,unit)
 print(f'Job [{jid}] resumed. Existing payload will be verified by libtorrent.')


def worker_io_pressure(jid):
    unit=f'torrent-worker-{jid}.service'

    try:
        cg=subprocess.check_output(
            [
                'systemctl','--user','show',unit,
                '-p','ControlGroup','--value'
            ],
            text=True,
            stderr=subprocess.DEVNULL,
        ).strip()
    except Exception:
        return None

    if not cg:
        return None

    pressure_file=Path('/sys/fs/cgroup') / cg.lstrip('/') / 'io.pressure'

    try:
        text=pressure_file.read_text()
    except OSError:
        return None

    for line in text.splitlines():
        if not line.startswith('full '):
            continue

        for field in line.split():
            if field.startswith('avg10='):
                try:
                    return float(field.split('=',1)[1])
                except ValueError:
                    return None

    return None


def recovery_cleared(jid):
    # Allow metadata/reverification activity to begin.
    time.sleep(10)

    low_samples=0

    while True:
        with locked_state() as s:
            j=get_job(s,jid)

            if not j:
                return True

            refresh(j)

            if not alive(j):
                return True

        pressure=worker_io_pressure(jid)

        # Conservative behavior if PSI cannot be read:
        # do not release another recovery job.
        if pressure is None:
            low_samples=0
            time.sleep(10)
            continue

        if pressure < 5.0:
            low_samples += 1
        else:
            low_samples = 0

        # Require a sustained quiet period.
        if low_samples >= 3:
            return True

        time.sleep(10)


def resume_dispatch():
    while True:
        with locked_state() as s:
            queued=[
                int(j['id'])
                for j in s['jobs']
                if j.get('state') == 'QUEUED'
            ]

        if not queued:
            return

        # Deterministic FIFO-by-job-ID recovery.
        jid=min(queued)

        try:
            resume(jid)

        except SystemExit as e:
            with locked_state() as s:
                j=get_job(s,jid)
                if j:
                    j['state']='STOPPED'

            print(
                f'Queued recovery failed for Job [{jid}]: {e}',
                file=sys.stderr,
            )
            continue

        recovery_cleared(jid)


def resume_all():
    with locked_state() as s:
        ids=[]

        for j in s['jobs']:
            refresh(j)

            if j.get('state') != 'STOPPED':
                continue

            j['state']='QUEUED'
            ids.append(int(j['id']))

    if not ids:
        print('SYSTEM RESUMED — no stopped torrent jobs.')
        return

    unit='torrent-resume-dispatch.service'

    active=subprocess.run(
        [
            'systemctl','--user','is-active',
            '--quiet',unit
        ],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    ).returncode == 0

    if not active:
        r=subprocess.run(
            [
                'systemd-run',
                '--user',
                '--quiet',
                '--collect',
                '--service-type=exec',
                f'--unit={unit}',
                str(Path.home()/'.local/bin/torrent-queue'),
                'resume-dispatch',
            ],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            text=True,
        )

        if r.returncode != 0:
            # Dispatcher failed: restore queue state.
            with locked_state() as s:
                for jid in ids:
                    j=get_job(s,jid)
                    if j and j.get('state') == 'QUEUED':
                        j['state']='STOPPED'

            raise SystemExit(
                'Unable to start controlled recovery: '
                + (r.stderr.strip() or 'systemd-run failed')
            )

    joined=' '.join(str(jid) for jid in ids)

    print(
        f'SYSTEM RESUMED — {len(ids)} job(s) queued '
        f'for controlled restart [{joined}].'
    )

def reconcile_payload(j,st):
 if not st or not st.get('metadata'):
  return

 name=(st.get('name') or '').strip()
 if not name:
  return

 candidate=Path(name)

 # Torrent metadata may identify only one top-level payload object.
 # Never permit absolute paths, traversal, or embedded separators.
 if (
  candidate.is_absolute()
  or len(candidate.parts)!=1
  or candidate.name in {'','.','..'}
  or '/' in name
  or '\\' in name
 ):
  return

 save=Path(j['save_path']).expanduser().resolve()
 actual=save/candidate.name

 j['torrent_name']=candidate.name
 j['expected_payload']=str(actual)

 # Existing filesystem object proves presence.
 # Positive libtorrent progress also proves this worker has observed
 # verified payload data, which arms later MISSING detection.
 if actual.exists():
  j['payload_seen']=True


def state_refreshed():
 live={}
 with locked_state() as s:
  for j in s['jobs']:
   st=live_status(j) if alive(j) else None
   reconcile_payload(j,st)
   refresh(j)

   # Re-apply an operator-selected file priority once per worker PID.
   # The worker may answer PENDING while the metadata approval gate
   # is still closed; it retains the sequence and activates it when
   # that existing gate opens.
   selected=j.get("priority_file_index")

   # Migrate the short-lived sequence UI. Its first native index was
   # the only file the worker actually promoted to maximum priority.
   if selected is None and isinstance(j.get("sequence_order"),list):
    legacy=j.get("sequence_order")
    if legacy:
     selected=int(legacy[0])
     j["priority_file_index"]=selected
    j.pop("sequence_order",None)
    j.pop("sequence_applied_pid",None)

   if (
    alive(j)
    and st
    and st.get("metadata")
    and selected is not None
    and int(j.get("priority_applied_pid") or 0)
        != int(j.get("pid") or 0)
   ):
    try:
     priority_command="SEQUENCE "+str(int(selected))

     priority_reply=socket_query(
      j,
      priority_command,
      timeout=3.0
     )

     if (
      priority_reply
      and priority_reply.startswith(
       "OK\tPRIORITY\t"
      )
     ):
      j["priority_applied_pid"]=int(j["pid"])
    except Exception:
     pass

   live[int(j['id'])]=st
  out=json.loads(json.dumps(s))

 for j in out['jobs']:
  j['_live_status']=live.get(int(j['id']))

 return out


# ============================================================
# PERMANENT PEER FILTER CONTROL
#
# torrent-get-filterd is the sole persistent deny authority
# and owns nft enforcement.
#
# torrent-mgmnt is an operator client only.
# ============================================================

FILTER_BACKEND_SOCKET=Path(
    "/run/torrent-get-filterd.sock"
)


def _filter_backend_query(payload):
    import socket

    if not FILTER_BACKEND_SOCKET.exists():
        return None

    try:
        with socket.socket(
            socket.AF_UNIX,
            socket.SOCK_STREAM,
        ) as sock:

            sock.settimeout(3.0)

            sock.connect(
                str(FILTER_BACKEND_SOCKET)
            )

            sock.sendall(
                (
                    json.dumps(payload)
                    + "\n"
                ).encode()
            )

            raw=b""

            while not raw.endswith(b"\n"):
                block=sock.recv(65536)

                if not block:
                    break

                raw+=block

                if len(raw) > 1024*1024:
                    return None

        if not raw:
            return None

        reply=json.loads(
            raw.decode()
        )

        if not isinstance(reply,dict):
            return None

        return reply

    except Exception:
        return None


def filter_backend_status():
    reply=_filter_backend_query(
        {"cmd":"status"}
    )

    if (
        not reply
        or not reply.get("ok")
    ):
        return None

    return reply


def filter_control_status():
    backend=filter_backend_status()

    print()
    print(
        "torrent-mgmnt — Permanent Peer Filter"
    )
    print()

    if not backend:
        print("Backend:     UNAVAILABLE")
        print("Enforcement: UNKNOWN")
        print()
        return False

    enforcing=bool(
        backend.get(
            "enforcing",
            False
        )
    )

    print("Backend:     NFT")
    print(
        "Active sets: "
        f"{int(backend.get('ipv4',0))} IPv4 / "
        f"{int(backend.get('ipv6',0))} IPv6"
    )
    print(
        f"Blocked:     "
        f"{int(backend.get('blocked',0))}"
    )
    print(
        "Generation:  "
        f"{int(backend.get('generation',0) or 0)}"
    )
    print(
        "Enforcement: "
        + (
            "ACTIVE"
            if enforcing
            else "INACTIVE"
        )
    )
    print(
        "Authority:   torrent-get-filterd"
    )

    try:
        limiter_pid=subprocess.check_output(
            [
                "systemctl",
                "--user",
                "show",
                "torrent-rate-regulator.service",
                "-p",
                "MainPID",
                "--value",
            ],
            text=True,
            stderr=subprocess.DEVNULL,
        ).strip()

        if (
            limiter_pid.isdigit()
            and int(limiter_pid) > 0
        ):
            print(
                f"Rate limiter: PID {limiter_pid}"
            )
        else:
            print(
                "Rate limiter: INACTIVE"
            )

    except Exception:
        print(
            "Rate limiter: UNAVAILABLE"
        )

    print()

    return enforcing


def filter_control_list():
    reply=_filter_backend_query(
        {"cmd":"list"}
    )

    print()
    print(
        "torrent-mgmnt — Permanent Blocked Peers"
    )
    print()

    if (
        not reply
        or not reply.get("ok")
    ):
        print("Filter backend unavailable.")
        print()
        return False

    ips=reply.get("ips",[])

    if not isinstance(ips,list):
        ips=[]

    print(
        "Generation: "
        f"{int(reply.get('generation',0) or 0)}"
    )
    print(
        f"Blocked:    "
        f"{int(reply.get('blocked',len(ips)))}"
    )
    print()

    if not ips:
        print("No permanent peer blocks.")
        print()
        return True

    for n,ip in enumerate(ips,1):
        print(f"{n:>4}  {ip}")

    print()

    return True


def filter_control_verify():
    status=_filter_backend_query(
        {"cmd":"status"}
    )

    listing=_filter_backend_query(
        {"cmd":"list"}
    )

    print()

    if (
        not status
        or not status.get("ok")
        or not listing
        or not listing.get("ok")
    ):
        print(
            "FAIL: permanent filter backend unavailable"
        )
        print()
        return False

    ips=listing.get("ips",[])

    if not isinstance(ips,list):
        ips=[]

    blocked=int(
        listing.get(
            "blocked",
            len(ips)
        )
    )

    status_blocked=int(
        status.get(
            "blocked",
            -1
        )
    )

    ipv4=int(
        status.get(
            "ipv4",
            -1
        )
    )

    ipv6=int(
        status.get(
            "ipv6",
            -1
        )
    )

    generation=int(
        status.get(
            "generation",
            -1
        )
    )

    list_generation=int(
        listing.get(
            "generation",
            -2
        )
    )

    ok=(
        bool(status.get("enforcing"))
        and blocked == len(ips)
        and status_blocked == blocked
        and ipv4 + ipv6 == blocked
        and generation == list_generation
    )

    if ok:
        print(
            "PASS: native permanent filter authority"
        )
        print(
            f"Generation: {generation}"
        )
        print(
            f"Blocked:    {blocked}"
        )
        print(
            f"IPv4:       {ipv4}"
        )
        print(
            f"IPv6:       {ipv6}"
        )
        print(
            "Enforcing:  YES"
        )
    else:
        print(
            "FAIL: native permanent filter authority"
        )
        print(
            f"Generation: {generation}"
        )
        print(
            f"Blocked:    {blocked}"
        )
        print(
            f"IPv4:       {ipv4}"
        )
        print(
            f"IPv6:       {ipv6}"
        )
        print(
            "Enforcing:  "
            + (
                "YES"
                if status.get("enforcing")
                else "NO"
            )
        )

    print()

    return ok


def filter_control_module():
    while True:
        filter_control_status()

        try:
            choice=input(
                "s=status, b=blocked, q=back: "
            ).strip()
        except (
            EOFError,
            KeyboardInterrupt,
        ):
            print()
            return

        if not choice:
            continue

        lowered=choice.casefold()

        if lowered in {
            "q","quit","back"
        }:
            return

        if lowered in {
            "s","status"
        }:
            continue

        if lowered in {
            "b","blocked","list"
        }:
            filter_control_list()

            try:
                input("Enter=back: ")
            except (
                EOFError,
                KeyboardInterrupt,
            ):
                print()

            continue

        # Hidden diagnostic command.
        if lowered in {
            "v","verify"
        }:
            filter_control_verify()
            continue

        print(
            "Use s=status, b=blocked, or q=back."
        )


def filter_control_direct(args):
    if not args:
        filter_control_module()
        return

    command=str(args[0]).casefold()

    if command in {
        "s","status"
    }:
        filter_control_status()
        return

    if command in {
        "b","blocked","list"
    }:
        filter_control_list()
        return

    if command in {
        "v","verify"
    }:
        filter_control_verify()
        return

    print(
        "Filter control accepts: status, list, verify."
    )


def _mgmnt_rate(value):
 v=float(max(0,int(value or 0)))
 units=['B/s','KiB/s','MiB/s','GiB/s','TiB/s']
 i=0
 while v>=1024 and i<len(units)-1:
  v/=1024
  i+=1
 if i==0:
  return f'{v:.0f} {units[i]}'
 return f'{v:.1f} {units[i]}'


def title_bar(title,rates=None):
 width=shutil.get_terminal_size((100,24)).columns
 clock=time.strftime('%I:%M %p').lstrip('0')

 if rates is None:
  right=clock
 else:
  down,up=rates
  right=(
   f"↓ {_mgmnt_rate(down)}  "
   f"↑ {_mgmnt_rate(up)}   "
   f"{clock}"
  )

 gap=3
 if width >= len(title)+len(right)+gap:
  print(title + ' '*(width-len(title)-len(right)) + right)
 else:
  print(title)
 print('-'*min(width,126))

