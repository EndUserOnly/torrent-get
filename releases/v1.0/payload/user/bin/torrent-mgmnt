  contents(jid)



def _gate_magnet(value):
    value=str(value or "").strip()

    if value.casefold().startswith("urn:btih:"):
        return value[9:]

    return value


def _gate_events():
    """
    Read TG_GATE evidence directly from existing per-job logs.

    No collector, socket, diagnostic IPC, or secondary viewer process.
    """
    events=[]

    try:
        state=state_refreshed()
    except Exception:
        return events

    for job in state.get("jobs",[]):
        log_path=job.get("log_path")

        if not log_path:
            continue

        path=Path(log_path)

        if not path.is_file():
            continue

        try:
            with path.open(
                "r",
                encoding="utf-8",
                errors="replace",
            ) as handle:

                for line in handle:

                    marker="TG_GATE\t"
                    pos=line.find(marker)

                    if pos<0:
                        continue

                    raw=line[pos+len(marker):].strip()

                    try:
                        record=json.loads(raw)
                    except Exception:
                        continue

                    if isinstance(record,dict):
                        events.append(record)

        except Exception:
            continue

    events.sort(
        key=lambda x:str(x.get("ts",""))
    )

    return events


def _gate_transactions(events):
    rows=[]
    current=None

    for event in events:

        name=str(
            event.get("event","")
        ).upper()

        if name=="RECEIVED":

            if current is not None:
                rows.append(current)

            current={
                "time":event.get("ts",""),
                "result":"PENDING",
                "store":"--",
                "manifest":"--",
                "approval":"--",
                "ms":None,
                "magnet":_gate_magnet(
                    event.get("torrent_id","")
                ),
            }

            continue

        if current is None:
            current={
                "time":event.get("ts",""),
                "result":"PENDING",
                "store":"--",
                "manifest":"--",
                "approval":"--",
                "ms":None,
                "magnet":_gate_magnet(
                    event.get("torrent_id","")
                ),
            }

        if not current["magnet"]:
            current["magnet"]=_gate_magnet(
                event.get("torrent_id","")
            )

        if name=="STORE_MATCH":
            current["store"]="MATCH"

        elif name=="STORE_MISSING":
            current["store"]="NEW"

        elif name=="STORE_MISMATCH":
            current["store"]="FAIL"

        elif name=="MANIFEST_MATCH":
            current["manifest"]="MATCH"

        elif name=="MANIFEST_MISMATCH":
            current["manifest"]="FAIL"

        elif name=="APPROVAL_REUSED":
            current["approval"]="REUSED"

        elif name=="APPROVAL_NEW":
            current["approval"]="NEW"

        elif name in {
            "PAYLOAD_UNDECLARED",
            "PAYLOAD_MISSING",
            "PAYLOAD_SPECIAL",
        }:
            current["manifest"]="FAIL"

        if name=="GATE_RELEASE":
            current["result"]="ALLOW"
            current["ms"]=event.get("elapsed_ms")
            rows.append(current)
            current=None

        elif name=="GATE_DENY":
            current["result"]="DENY"
            current["ms"]=event.get("elapsed_ms")
            rows.append(current)
            current=None

    if current is not None:
        rows.append(current)

    return rows


def _gate_time(value):
    value=str(value or "")

    if not value:
        return "--"

    try:
        from datetime import datetime

        dt=datetime.fromisoformat(
            value.replace("Z","+00:00")
        )

        return dt.astimezone().strftime(
            "%H:%M:%S"
        )

    except Exception:
        return value[:8]


def gatekeeper_log_module():

    page=0
    live=True

    page_size=max(
        5,
        shutil.get_terminal_size(
            (120,24)
        ).lines-8,
    )

    last_signature=None

    while True:

        events=_gate_events()
        rows=_gate_transactions(events)

        signature=(
            len(events),
            json.dumps(
                events[-1],
                sort_keys=True,
                default=str,
            )
            if events
            else "",
        )

        pages=max(
            1,
            (len(rows)+page_size-1)//page_size,
        )

        if live:
            page=pages-1

        if signature!=last_signature:

            if sys.stdout.isatty():
                print("\033[2J\033[H",end="")

            width=shutil.get_terminal_size(
                (120,24)
            ).columns

            mode=(
                "LIVE"
                if live and page==pages-1
                else f"HISTORY {page+1}/{pages}"
            )

            print(
                "torrent-mgmnt — Gatekeeper Traffic — "
                + mode
            )

            print("-"*min(width,145))

            print(
                f"{'Time':<9} "
                f"{'Result':<7} "
                f"{'Store':<9} "
                f"{'Manifest':<9} "
                f"{'Approval':<9} "
                f"{'ms':>7}  "
                f"Magnet #"
            )

            print("-"*min(width,145))

            start=page*page_size
            end=min(
                len(rows),
                start+page_size,
            )

            for row in rows[start:end]:

                elapsed=row.get("ms")

                ms=(
                    "--"
                    if elapsed is None
                    else f"{float(elapsed):.1f}"
                )

                print(
                    f"{_gate_time(row.get('time')):<9} "
                    f"{row.get('result','--'):<7} "
                    f"{row.get('store','--'):<9} "
                    f"{row.get('manifest','--'):<9} "
                    f"{row.get('approval','--'):<9} "
                    f"{ms:>7}  "
                    f"{row.get('magnet') or '--'}"
                )

            print()

            print(
                f"Transactions "
                f"{start+1 if rows else 0}-{end} "
                f"of {len(rows)}"
            )

            print(
                "p=previous, n=next, l=live, "
                "r=refresh, q=back"
            )

            last_signature=signature

        try:
            ready,_,_=select.select(
                [sys.stdin],
                [],
                [],
                0.5,
            )

        except Exception:
            ready=[]

        if not ready:
            continue

        choice=sys.stdin.readline()

        if choice=="":
            return

        choice=choice.strip().casefold()

        if choice in {"q","quit","exit"}:
            return

        if choice in {"l","live"}:
            live=True
            last_signature=None
            continue

        if choice.strip().casefold() in {"con","config","configure"}:
            configure_download_folder()
            continue

        if choice in {"r","refresh"}:
            last_signature=None
            continue

        if choice in {"p","previous","prev"}:
            live=False
            page=max(0,page-1)
            last_signature=None
            continue

        if choice in {"n","next"}:

            if page<pages-1:
                page+=1
                live=False
            else:
                live=True

            last_signature=None
            continue


def blocked_peers_log_module():
    """
    Live persistent blocked-peer view under Diagnostic Logs.

    torrent-get-filterd remains the sole persistent deny authority.
    Existing peer-control code remains the unblock mutation path.
    """

    while True:
        reply=_filter_backend_query(
            {"cmd":"list"}
        )

        print()
        print(
            "torrent-mgmnt — Blocked Peers"
        )
        print()

        if (
            not reply
            or not reply.get("ok")
        ):
            print("Filter backend unavailable.")
            print()

            try:
                choice=input(
                    "r=refresh, q=back: "
                ).strip().casefold()
            except (
                EOFError,
                KeyboardInterrupt,
            ):
                print()
                return

            if choice in {
                "q","quit","back","exit"
            }:
                return

            continue

        ips=reply.get("ips",[])

        if not isinstance(ips,list):
            ips=[]

        ips=[
            str(ip).strip()
            for ip in ips
            if str(ip).strip()
        ]

        records=[
            (number,ip)
            for number,ip in enumerate(ips,1)
        ]
        found_records=[]

        print(
            f"Set: {len(records)}/4096 | "
            f"Capacity: {max(0,4096-len(records))}"
        )
        print()

        if not records:
            print("No permanent peer blocks.")
            print()

        else:
            for number,ip in records:
                print(
                    f"{number:>4}  {ip}"
                )

            print()

        #
        # Stay inside this command loop.
        #
        # The complete list is printed again ONLY
        # when the operator explicitly requests refresh.
        #
        while True:
            try:
                choice=input(
                    "u RECORD...=unblock, trim found, "
                    "d=delete log contents, "
                    "f=find, r=refresh, q=back: "
                ).strip()
            except (
                EOFError,
                KeyboardInterrupt,
            ):
                print()
                return

            if not choice:
                continue

            parts=choice.split()
            command=parts[0].casefold()

            if command in {
                "q","quit","back","exit"
            }:
                return

            if command in {
                "r","refresh"
            }:
                break

            if command in {
                "f","find"
            }:
                if len(parts)==1:
                    try:
                        needle=input(
                            "Find IP: "
                        ).strip()
                    except (
                        EOFError,
                        KeyboardInterrupt,
                    ):
                        print()
                        continue

                else:
                    needle=" ".join(
                        parts[1:]
                    ).strip()

                if not needle:
                    print("Find cancelled.")
                    print()
                    continue

                matches=[
                    (number,ip)
                    for number,ip in records
                    if needle.casefold()
                    in ip.casefold()
                ]
                found_records=matches

                print()

                if matches:
                    print(
                        f"FOUND: {needle}"
                    )
                    print()

                    for number,ip in matches:
                        print(
                            f"{number:>4}  {ip}"
                        )

                else:
                    print(
                        f"NOT FOUND: {needle}"
                    )

                print()

                #
                # Stay here.
                # Do NOT redraw the complete list.
                #
                continue

            if command=="trim":
                if len(parts)!=2 or parts[1].casefold()!="found":
                    print("Usage: trim found")
                    continue
                if not found_records:
                    print("No current find results to trim.")
                    continue
                if len(found_records)>256:
                    print("Trim exceeds the 256-record batch limit; narrow the find.")
                    continue
                selected_ips=[ip for _,ip in found_records]
                answer=input(
                    f"Trim {len(selected_ips)} found block(s)? Type trim to confirm: "
                ).strip().casefold()
                if answer!="trim":
                    print("Trim cancelled.")
                    continue
                result=_filter_backend_query(
                    {"cmd":"unblock_many","ips":selected_ips}
                )
                if not result or not result.get("ok"):
                    print("Trim failed: " + str((result or {}).get("error","backend unavailable")))
                    continue
                print(f"Trimmed {len(result.get('changed',[]))} persistent block(s).")
                break

            if command in {"d","delete"}:
                if not records:
                    print("No permanent peer blocks.")
                    continue
                answer=input(
                    f"Delete all {len(records)} blocked-peer log records "
                    "and unblock every IP? Type delete to confirm: "
                ).strip().casefold()
                if answer!="delete":
                    print("Delete cancelled.")
                    continue
                failure=None
                removed=0
                all_ips=[ip for _,ip in records]
                for start in range(0,len(all_ips),256):
                    result=_filter_backend_query(
                        {"cmd":"unblock_many","ips":all_ips[start:start+256]}
                    )
                    if not result or not result.get("ok"):
                        failure=str((result or {}).get("error","backend unavailable"))
                        break
                    removed+=len(result.get("changed",[]))
                print(f"Deleted {removed} blocked-peer log record(s).")
                if failure:
                    print("Delete stopped: " + failure)
                break

            if command not in {
                "u","unblock"
            }:
                print(
                    "Use u RECORD...=unblock, trim found, "
                    "d=delete log contents, f=find, r=refresh, q=back."
                )
                continue

            if not records:
                print(
                    "No permanent peer blocks."
                )
                continue

            if len(parts)==1:
                try:
                    raw=input(
                        "Record number to unblock: "
                    ).strip()
                except (
                    EOFError,
                    KeyboardInterrupt,
                ):
                    print()
                    continue

            else:
                raw=" ".join(parts[1:])

            numbers=[]
            try:
                for token in raw.replace(","," ").split():
                    if "-" in token:
                        first,last=(int(item) for item in token.split("-",1))
                        if first>last:
                            raise ValueError
                        numbers.extend(range(first,last+1))
                    else:
                        numbers.append(int(token))
            except ValueError:
                print("Invalid record selection.")
                continue
            numbers=list(dict.fromkeys(numbers))
            if not numbers or len(numbers)>256 or any(n<1 or n>len(records) for n in numbers):
                print("Invalid record selection or 256-record batch limit exceeded.")
                continue
            selected_ips=[records[n-1][1] for n in numbers]
            result=_filter_backend_query(
                {"cmd":"unblock_many","ips":selected_ips}
            )
            if not result or not result.get("ok"):
                print("Unable to unblock: " + str((result or {}).get("error","backend unavailable")))
                continue

            #
            # Certify against the persistent authority.
            #
            verify=_filter_backend_query(
                {"cmd":"list"}
            )

            verify_ips=(
                verify.get("ips",[])
                if (
                    verify
                    and verify.get("ok")
                )
                else None
            )

            if (
                isinstance(verify_ips,list)
                and not set(selected_ips) & {
                    str(item).strip()
                    for item in verify_ips
                }
            ):
                print(
                    f"Unblocked {len(selected_ips)} persistent block(s)."
                )
                break

            else:
                print(
                    f"Unblock not confirmed "
                    f"for {ip}."
                )



def diagnostic_logs_module():
    """
    Diagnostic branch point.

    New diagnostics can be added here without new processes.
    """

    while True:

        width=shutil.get_terminal_size(
            (100,24)
        ).columns

        print()
        print(
            "torrent-mgmnt — Diagnostic Logs"
        )

        print("-"*min(width,100))
        print()
        print("1  Gatekeeper Traffic — live")
        print("2  Blocked Peers — live")
        print()
        print("q  back")
        print()

        try:
            choice=input(
                "logs: "
            ).strip().casefold()

        except (
            EOFError,
            KeyboardInterrupt,
        ):
            print()
            return

        if choice in {"q","quit","exit"}:
            return

        if choice in {"1","gate","gatekeeper"}:
            gatekeeper_log_module()
            continue

        if choice in {
            "2","blocked","blocks","peers"
        }:
            blocked_peers_log_module()
            continue

        print(
            "Use 1=Gatekeeper Traffic, "
            "2=Blocked Peers, or q=back."
        )


def management_module():
    """
    Persistent operator control center.

    Bare `torrent-queue` enters here.
    Explicit subcommands retain normal one-shot CLI behavior.
    """
    while True:
        listq()

        try:
            choice=input(
                "r=refresh, rm [ids]=remove, c [ids]=contents, pr [ids]=prune, p=peers, f=filter, con=configure, l=logs, m=maintenance, q=quit: "
            ).strip()
        except (EOFError, KeyboardInterrupt):
            print()
            return

        # Direct space-delimited management commands.
        # These are handled HERE, before legacy dispatch.
        parts=choice.split()

        # DIRECT CONFIGURATION COMMAND
        #
        # Configuration belongs entirely to torrent-mgmnt.
        # Consume it here so it can never fall through to
        # torrent-queue argparse.
        if (
            parts
            and parts[0].casefold()
            in {"con","config","configure"}
        ):
            if len(parts)!=1:
                print(
                    "Usage: con"
                )
                continue

            configure_download_folder()
            continue


        if len(parts)>1:
            direct_cmd=parts[0].casefold()

            # DIRECT PEER VIEW
            #
            #   p 294
            #   peers 294
            #   p all
            #
            # Bare `p` retains the established interactive prompt.
            if direct_cmd in {"p","peers"}:

                if len(parts)!=2:
                    print(
                        "Peer view accepts one numeric job ID or 'all'."
                    )
                    continue

                target=parts[1].strip()

                if target.casefold()=="all":
                    target="all"

                else:
                    try:
                        jid=int(target)
                    except ValueError:
                        print(
                            "Peer view accepts one numeric job ID or 'all'."
                        )
                        continue

                    if jid < 1:
                        print(
                            "Peer view requires a positive job ID."
                        )
                        continue

                    try:
                        validate_job_ids([jid])
                    except SystemExit as exc:
                        print(exc)
                        continue

                    target=str(jid)

                # Replace Management with the existing Peer Control
                # process. Peer Control `q` already returns directly
                # to torrent-mgmnt.
                if not PEERS.is_file() or not os.access(PEERS,os.X_OK):
                    raise SystemExit(
                        f"torrent-peers is not executable: {PEERS}"
                    )
                os.execv(
                    str(PEERS),
                    [
                        str(PEERS),
                        target,
                    ],
                )

            if direct_cmd in {"c","contents","rm","remove","pr","prune"}:
                direct_args=parts[1:]
                inline_remove_answer=None

                # Hidden inline-answer grammar:
                #
                #   rm 373 n
                #   rm 373 y
                #   rm 373 382 n
                #   rm 373 382 y
                #
                # The final y/n token answers only the existing
                # payload-removal confirmation. Without it, existing
                # prompt behavior is unchanged.
                if (
                    direct_cmd in {"rm","remove"}
                    and direct_args
                    and direct_args[-1].casefold()
                    in {"y","yes","n","no"}
                ):
                    inline_remove_answer=(
                        direct_args[-1].casefold()
                    )
                    direct_args=direct_args[:-1]

                try:
                    direct_ids=_parse_numeric_selection(direct_args)
                except ValueError:
                    print("Invalid job ID selection.")
                    continue

                if direct_cmd in {"c","contents"}:
                    try:
                        os.environ[
                            "TORRENT_MGMNT_INTERNAL_CONTENTS"
                        ]="1"

                        contents_many(direct_ids)

                    finally:
                        os.environ.pop(
                            "TORRENT_MGMNT_INTERNAL_CONTENTS",
                            None
                        )

                    continue

                if direct_cmd in {"rm","remove"}:
                    if not direct_ids:
                        print(
                            "Remove requires at least one numeric job ID."
                        )
                        continue

                    count=len(direct_ids)
                    noun='torrent' if count==1 else 'torrents'

                    if inline_remove_answer is not None:
                        answer=inline_remove_answer
                    else:
                        try:
                            answer=input(
                                f"Remove payloads for all {count} {noun}? [y/N]: "
                            ).strip().casefold()
                        except (EOFError,KeyboardInterrupt):
                            print()
                            answer=''

                    remove_payload=(
                        answer in {"y","yes"}
                    )

                    remove_many(
                        direct_ids,
                        delete_payload=remove_payload,
                    )
                    continue

                if direct_cmd in {"pr","prune"}:
                    for jid in direct_ids:
                        prune(jid)
                    continue

        if not choice:
            continue

        lowered=choice.casefold()

        qparts=choice.split()

        if (
            qparts
            and qparts[0].casefold()
            in {"f","filter"}
        ):
            filter_control_direct(
                qparts[1:]
            )
            continue

        if lowered in {"l","logs"}:
            diagnostic_logs_module()
            continue

        if lowered in {"m","maint","maintenance"}:
            maint_operator_module()
            continue

        qparts=choice.split()

        if (
            qparts
            and qparts[0].casefold() in {"q","quit","exit"}
        ):
            # Hidden inline-answer grammar:
            #
            #   q
            #   q y
            #   q n
            #   q y n
            #
            # The first answer belongs to Management.
            # A valid third token is consumed as the chained answer,
            # allowing both confirmations to be typed at once.
            #
            # Management itself acts only on the first answer.
            # The chained answer must never invalidate q y.
            inline_answers=[
                part.casefold()
                for part in qparts[1:]
            ]

            valid_answers={"y","yes","n","no"}

            if (
                1 <= len(inline_answers) <= 2
                and all(
                    answer in valid_answers
                    for answer in inline_answers
                )
            ):
                answer=inline_answers[0]

                chained_answer=(
                    inline_answers[1]
                    if len(inline_answers)==2
                    else None
                )

            else:
                chained_answer=None

                try:
                    answer=input(
                        "Quit Torrent Management? y/n: "
                    ).strip().casefold()
                except (EOFError,KeyboardInterrupt):
                    print()
                    continue

            if answer in {"y","yes"}:
                return

            # n/no keeps Management open regardless of any
            # pre-supplied chained answer.
            continue

        if lowered in {"r","refresh"}:
            continue

        if lowered in {"pr","prune"}:
            try:
                raw_id=input(
                    "Prune job ID, or Enter for all eligible: "
                ).strip()
            except (EOFError,KeyboardInterrupt):
                print()
                continue

            if raw_id:
                try:
                    jid=int(raw_id)
                except ValueError:
                    print(
                        "Prune accepts one numeric job ID, "
                        "or Enter for all eligible."
                    )
                    continue

                prune_args=[
                    "prune",
                    str(jid),
                ]
            else:
                prune_args=[
                    "prune",
                ]

            old_argv=sys.argv[:]

            try:
                os.environ[
                    "TORRENT_MGMNT_INTERNAL_PRUNE"
                ]="1"

                sys.argv=[
                    os.path.abspath(__file__),
                    *prune_args,
                ]

                main()

            except SystemExit as exc:
                if exc.code not in (None,0):
                    print(exc)

            finally:
                os.environ.pop(
                    "TORRENT_MGMNT_INTERNAL_PRUNE",
                    None
                )
                sys.argv=old_argv

            print()

            # Return directly to the refreshed management list.
            continue

        if lowered in {"p","peers"}:
            try:
                target=input(
                    "Peer view — job ID, or Enter for all: "
                ).strip()
            except (EOFError, KeyboardInterrupt):
                print()
                continue

            if not target or target.casefold()=="all":
                # ALL peers remain in the torrent-mgmnt foreground.
                _peer_all_foreground()
                continue

            try:
                job_id=int(target)
            except ValueError:
                print(
                    "Peer view accepts one numeric job ID "
                    "or Enter for all."
                )
                continue

            if job_id < 1:
                print(
                    "Peer view requires a positive job ID."
                )
                continue

            # p ID deliberately remains unchanged.
            #
            # Existing torrent-peers job-scoped interface takes over,
            # and its q path returns to torrent-mgmnt as before.
            if not PEERS.is_file() or not os.access(PEERS,os.X_OK):
                raise SystemExit(
                    f"torrent-peers is not executable: {PEERS}"
                )
            os.execv(
                str(PEERS),
                [
                    str(PEERS),
                    str(job_id),
                ],
            )

        if lowered in {"c","contents"}:
            try:
                raw_id=input(
                    "Contents job ID: "
                ).strip()
            except (EOFError,KeyboardInterrupt):
                print()
                continue

            if not raw_id:
                continue

            try:
                jid=int(raw_id)
            except ValueError:
                print(
                    "Contents requires one numeric job ID."
                )
                continue

            old_argv=sys.argv[:]

            try:
                os.environ[
                    "TORRENT_MGMNT_INTERNAL_CONTENTS"
                ]="1"

                sys.argv=[
                    os.path.abspath(__file__),
                    "contents",
                    str(jid),
                ]

                main()

            except SystemExit as exc:
                if exc.code not in (None,0):
                    print(exc)

            finally:
                os.environ.pop(
                    "TORRENT_MGMNT_INTERNAL_CONTENTS",
                    None
                )
                sys.argv=old_argv

            print()

            # Return directly to the refreshed management list.
            continue

        if lowered == "rm":
            try:
                raw_ids=input(
                    "Remove job ID(s): "
                ).strip()
            except (EOFError, KeyboardInterrupt):
                print()
                continue

            if not raw_ids:
                continue

            try:
                ids=_parse_numeric_selection(raw_ids)
            except ValueError:
                print(
                    "Remove accepts numeric job IDs and ranges."
                )
                continue

            try:
                try:
                    payload_choice=input(
                        "Delete payload(s)? y/n: "
                    ).strip().casefold()
                except (EOFError,KeyboardInterrupt):
                    print()
                    continue
                if payload_choice in {"y","yes"}:
                    delete_payload=True
                elif payload_choice in {"n","no"}:
                    delete_payload=False
                else:
                    print("Enter y or n.")
                    continue

                remove_many(
                    ids,
                    delete_payload=delete_payload
                )
            except SystemExit as exc:
                print(exc)
                continue

            # Removal completed through the existing lifecycle:
            # stop owned worker -> delete queue record -> retain payload.
            # Return directly to the refreshed management list.
            continue

        try:
            args=shlex.split(choice)
        except ValueError as exc:
            print(f"Input error: {exc}")
            continue

        if not args:
            continue

        # Bare management mode remains the parent control center.
        # Existing torrent-queue commands execute through the exact
        # same one-shot command surface already used from Bash.
        try:
            result=subprocess.run(
                [
                    sys.executable,
                    os.path.abspath(__file__),
                    *args,
                ],
                check=False,
            )
        except OSError as exc:
            print(f"Unable to execute torrent-queue action: {exc}")
            continue

        if result.returncode != 0:
            print(
                f"Action returned status {result.returncode}."
            )

        print()



def _peer_backend(args,env=None):
    command=[
        str(
            Path.home()
            / ".local/bin/torrent-peers"
        ),
        *args,
    ]

    run_env=os.environ.copy()
    run_env["COLUMNS"]=str(
        shutil.get_terminal_size((100,24)).columns
    )

    if env:
        run_env.update(env)

    result=subprocess.run(
        command,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        env=run_env,
    )

    if result.returncode != 0:
        raise RuntimeError(
            result.stderr.strip()
            or result.stdout.strip()
            or "torrent-peers backend failed"
        )

    return result.stdout


# Maintenance is deliberately self-contained in torrent-mgmnt.  In
# particular, these commands run before normal queue reconciliation so the
# read-only operations cannot create directories, lock files, or state writes.
TORRENT_GET_STATE=HOME/".local/share/torrent-get"
TORRENT_GET_CACHE=HOME/".cache/torrent-get"

MAINT_PROTECTED=(
 TORRENT_GET_CONFIG,
 TORRENT_GET_STATE/"geoip",
 METADATA_APPROVAL_ROOT,
 TORRENT_GET_STATE/"security",
 TORRENT_GET_STATE/"peer-observation",
 NETWORK_PAUSE_STATE,
 STATE_FILE,
 LOCK_FILE,
 LOG_DIR,
 RESUME_DIR,
)

_MAINT_ARTIFACT_DIR=re.compile(r".+-[0-9]{8}-[0-9]{6}$")
_MAINT_ARTIFACT_FILE=re.compile(
 r"(?:torrent-(?:get|mgmnt|queue|peers|worker-posix|approval-bridge)|"
 r"magnet-search)(?:\.(?:pre|before|candidate|live-before|new|logs|"
 r"native-logs|nft-only|approval-v1|approval-v1-regressed|"
 r"pre-production-bake|pre-import-shell-guard|pre-magnet-import-cleanup|"
 r"pre-foreground-softfail|pre-infohash-dedupe|pre-logs-blocked-peers|"
 r"pre-magnet-cleanup|pre-magnet-only|pre-native-filter|"
 r"pre-remove-many-opt|pre-runtime-bake|pre-batch-filter|"
 r"pre-remove-observed|pre-nft-only-certified|pre-none-pid-fix))"
 r"(?:-[0-9]{8}(?:-[0-9]{6})?)?$"
)


def _maint_size(path):
 try:
  if path.is_symlink() or path.is_file():
   return path.lstat().st_size
  return sum(
   item.lstat().st_size
   for item in path.rglob("*")
   if item.is_file() or item.is_symlink()
  )
 except OSError:
  return 0


def _maint_clean_candidates():
 """Return only names whose shape proves they are build/backup leftovers."""
 candidates=[]
 try:
  children=list(TORRENT_GET_STATE.iterdir())
 except OSError:
  children=[]

 for path in children:
  if path in MAINT_PROTECTED:
   continue
  if path.is_dir() and _MAINT_ARTIFACT_DIR.fullmatch(path.name):
   candidates.append(path)
  elif path.is_file() and _MAINT_ARTIFACT_FILE.fullmatch(path.name):
   candidates.append(path)

 return sorted(candidates,key=lambda item:item.name)


def _maint_inventory():
 candidates=_maint_clean_candidates()
 queue={"readable":False,"jobs":None,"live_jobs":None}
 try:
  state=json.loads(STATE_FILE.read_text())
  jobs=state.get("jobs",[])
  queue={
   "readable":True,
   "jobs":len(jobs),
   "live_jobs":sum(
    1 for job in jobs
    if alive(job) or systemd_main_pid(
     job.get("systemd_unit")
     or f"torrent-worker-{job.get('id')}.service"
    ) not in (None,0)
   ),
  }
 except Exception:
  pass

 return {
  "queue":queue,
  "clean_candidates":len(candidates),
  "clean_bytes":sum(_maint_size(path) for path in candidates),
  "protected":{
   str(path):path.exists()
   for path in MAINT_PROTECTED
  },
  "logs":{
   "files":len(_maint_logs()),
   "bytes":sum(_maint_size(path) for _,path in _maint_logs()),
  },
 }


def maint_audit():
 print("torrent-mgmnt maint audit (read-only)")
 print(json.dumps(_maint_support_report(),indent=2,sort_keys=True))


def maint_clean(apply=False):
 candidates=_maint_clean_candidates()
 print(
  "torrent-mgmnt maint clean — "
  + ("EXECUTING" if apply else "Items to be cleaned")
 )

 if not candidates:
  print("No proven disposable torrent-get-owned state found.")
  return

 failures=[]
 for path in candidates:
  size=_maint_size(path)
  print(f"{'REMOVE' if apply else 'ITEM'}\t{size}\t{path}")
  if not apply:
   continue
  try:
   if path.is_dir() and not path.is_symlink():
    shutil.rmtree(path)
   else:
    path.unlink()
  except OSError as exc:
   failures.append((path,exc))

 if failures:
  for path,exc in failures:
   print(f"FAILED\t{path}\t{exc}",file=sys.stderr)
  raise SystemExit(1)

 print(
  f"{'Removed' if apply else 'Candidates'}: {len(candidates)} | "
  f"Bytes: {sum(_maint_size(path) for path in candidates) if not apply else 'reported above'}"
 )


def _maint_clear_contents(root):
 if not root.exists():
  return 0
 if root.is_symlink() or not root.is_dir():
  raise RuntimeError(f"refusing non-directory live-state root: {root}")
 removed=0
 for child in list(root.iterdir()):
  if child.is_dir() and not child.is_symlink():
   shutil.rmtree(child)
  else:
   child.unlink()
  removed+=1
 return removed


def maint_flush(selection=None):
 if selection is None:
  print("torrent-mgmnt maint flush")
  for number,(name,(description,roots)) in enumerate(
   MAINT_FLUSH_CLASSES.items(),1
  ):
   entries=sum(
    1 for root in roots
    for _ in (root.iterdir() if root.is_dir() else ())
   )
   print(f"{number}  {name} — {description} ({entries} entries)")
  try:
   raw=input("Select exactly one class, or q to cancel: ").strip()
  except (EOFError,KeyboardInterrupt):
   print()
   return
  if raw.casefold() in {"q","quit","exit"}:
   return
  names=list(MAINT_FLUSH_CLASSES)
  if raw.isdigit() and 1 <= int(raw) <= len(names):
   selection=names[int(raw)-1]
  else:
   selection=raw

 if selection not in MAINT_FLUSH_CLASSES:
  raise SystemExit(
   "flush requires exactly one of: "
   + ", ".join(MAINT_FLUSH_CLASSES)
  )

 description,roots=MAINT_FLUSH_CLASSES[selection]
 removed=sum(_maint_clear_contents(root) for root in roots)
 print(f"Flushed {selection}: {removed} entries cleared ({description}).")


def _maint_logs():
 logs=[]
 for label,root in (
  ("queue",LOG_DIR),("security",TORRENT_GET_STATE/"security/logs")
 ):
  if not root.is_dir():
   continue
  for path in sorted(root.rglob("*"),key=lambda item:str(item)):
   if path.is_file() and not path.is_symlink():
    logs.append((label,path))
 return logs


def _maint_log_view(path):
 limit=256*1024
 with path.open("rb") as handle:
  handle.seek(0,os.SEEK_END)
  size=handle.tell()
  clipped=size>limit
  handle.seek(max(0,size-limit),os.SEEK_SET)
  content=handle.read().decode("utf-8",errors="replace")
 if clipped:
  content="[showing latest 256 KiB]\n"+content
 return _maint_redact(content).rstrip() or "[empty log]"


def _maint_flush_log(path):
 allowed={candidate.resolve() for _,candidate in _maint_logs()}
 target=path.resolve()
 if target not in allowed or path.is_symlink() or not path.is_file():
  raise RuntimeError("refusing unowned or non-regular log file")
 fd=os.open(target,os.O_WRONLY|os.O_TRUNC)
 try:
  os.fsync(fd)
 finally:
  os.close(fd)


def _maint_flush_all_logs():
 logs=list(_maint_logs())
 cleared=[]
 failures=[]
 for _,path in logs:
  try:
   _maint_flush_log(path)
   cleared.append(path.name)
  except Exception as exc:
   failures.append((path.name,str(exc)))
 return cleared,failures


def _maint_file_facts(path):
 try:
  st=path.lstat()
  facts={
   "exists":True,
   "type":"directory" if path.is_dir() else "file",
   "mode":oct(st.st_mode & 0o777),
   "size":st.st_size,
   "mtime":time.strftime(
    "%Y-%m-%dT%H:%M:%SZ",time.gmtime(st.st_mtime)
   ),
  }
  if path.is_file() and not path.is_symlink() and st.st_size<=10*1024*1024:
   facts["sha256"]=hashlib.sha256(path.read_bytes()).hexdigest()
  return facts
 except OSError as exc:
  return {"exists":False,"error":str(exc)}


def _maint_command(command):
 try:
  result=subprocess.run(
   command,text=True,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,
   timeout=5,check=False,
  )
  return {
   "status":result.returncode,
   "output":_maint_redact(result.stdout.strip()),
  }
 except Exception as exc:
  return {"error":str(exc)}


def _maint_redact(value):
 text=str(value)
 text=re.sub(r"magnet:\?\S+","<redacted-magnet>",text)
 return text.replace(str(HOME),"~")


def _maint_current_logs():
 result={}
 roots={
  "queue":LOG_DIR,
  "security":TORRENT_GET_STATE/"security/logs",
 }
 for label,root in roots.items():
  if not root.is_dir():
   result[label]=None
   continue
  files=[
   path for path in root.iterdir()
   if path.is_file() and not path.is_symlink()
  ]
  result[label]=max(
   files,key=lambda path:path.stat().st_mtime
  ).name if files else None
 return result


def _maint_disk_facts(path):
 try:
  usage=shutil.disk_usage(path)
  return {"total":usage.total,"used":usage.used,"free":usage.free}
 except OSError as exc:
  return {"error":str(exc)}


def _maint_memory_facts():
 wanted={"MemTotal","MemAvailable","SwapTotal","SwapFree"}
 result={}
 try:
  for line in Path("/proc/meminfo").read_text().splitlines():
   key,_,value=line.partition(":")
   if key in wanted:
    result[key]=value.strip()
 except OSError as exc:
  result["error"]=str(exc)
 return result


def _maint_support_report():
 inventory=_maint_inventory()
 inventory["protected"].pop(
  str(TORRENT_GET_STATE/"peer-observation"),None
 )
 software_paths=(
  Path(__file__).resolve(),
  HOME/".local/bin/torrent-get",
  HOME/".local/bin/torrent-peers",
  HOME/".local/bin/magnet-search",
  HOME/".local/libexec/torrent-worker-posix",
  HOME/".local/libexec/torrent-approval-bridge",
  HOME/".local/lib/torrent-get/security/approval_store.py",
  HOME/".config/systemd/user/torrent-rate-regulator.service",
 )
 report={
  "generated_at":time.strftime("%Y-%m-%dT%H:%M:%SZ",time.gmtime()),
  "program":str(Path(__file__).resolve()),
  "python":sys.version.split()[0],
  "system":{
   "platform":sys.platform,
   "uname":list(os.uname()),
   "boot_id":boot_id(),
   "memory":_maint_memory_facts(),
   "systemd":_maint_command(["systemctl","--version"]),
  },
  "inventory":inventory,
  "software":{
   str(path):_maint_file_facts(path)
   for path in software_paths
  },
  "state_paths":{
   str(path):_maint_file_facts(path)
   for path in (
    TORRENT_GET_CONFIG,NETWORK_PAUSE_STATE,STATE_FILE,LOCK_FILE,
    LOG_DIR,RESUME_DIR,METADATA_APPROVAL_ROOT,
    TORRENT_GET_STATE/"security/logs",TORRENT_GET_CACHE,
   )
  },
  "storage":{
   str(path):_maint_disk_facts(path)
   for path in {
    HOME,STATE_DIR,TORRENT_GET_STATE,_configured_download_folder(),
   }
  },
 }
 try:
  state=json.loads(STATE_FILE.read_text())
  report["queue_next_id"]=state.get("next_id")
  report["queue_jobs"]=[
   {
    "id":job.get("id"),
    "state":job.get("state"),
    "alive":(
     alive(job)
     or systemd_main_pid(
      job.get("systemd_unit")
      or f"torrent-worker-{job.get('id')}.service"
     ) not in (None,0)
    ),
    "systemd_unit":job.get("systemd_unit"),
    "pid":job.get("pid"),
    "pid_start":job.get("pid_start"),
    "save_path":_maint_redact(job.get("save_path","")),
    "checkpoint":checkpoint_status(job),
    "activity":activity(job.get("state"),job),
   }
   for job in state.get("jobs",[])
  ]
 except Exception as exc:
  report["queue_error"]=str(exc)
 try:
  report["network_pause"]=json.loads(NETWORK_PAUSE_STATE.read_text())
 except Exception as exc:
  report["network_pause_error"]=str(exc)
 report["current_log_files"]=_maint_current_logs()
 units=["torrent-rate-regulator.service"]+[
  job.get("systemd_unit") or f"torrent-worker-{job.get('id')}.service"
  for job in state.get("jobs",[])
 ] if "state" in locals() else ["torrent-rate-regulator.service"]
 report["service_state"]={
  unit:_maint_command([
   "systemctl","--user","show",unit,
   "--property=Id,LoadState,ActiveState,SubState,MainPID,ExecMainStatus,"
   "MemoryCurrent,TasksCurrent,CPUUsageNSec,StateChangeTimestamp",
  ])
  for unit in units
 }
 return report


def maint_dump():
 stamp=time.strftime("%Y%m%d-%H%M%S",time.localtime())
 destination=HOME/f"torrent-mgmnt-dump-{stamp}-{os.getpid()}.json"
 report=_maint_support_report()

 payload=(json.dumps(report,indent=2,sort_keys=True)+"\n").encode()
 fd=os.open(destination,os.O_WRONLY|os.O_CREAT|os.O_EXCL,0o600)
 try:
  offset=0
  while offset<len(payload):
   offset+=os.write(fd,payload[offset:])
  os.fsync(fd)
 finally:
  os.close(fd)
 print("Support dump created:")
 print(f"  {destination}")
 print()
 print("Submit this file for investigation.")


def _maint_capture(action,*args):
 output=io.StringIO()
 try:
  with contextlib.redirect_stdout(output),contextlib.redirect_stderr(output):
   action(*args)
 except SystemExit as exc:
  if exc.code not in (None,0):
   print(exc,file=output)
 return output.getvalue().rstrip()


def _maint_redraw(title,body,commands):
 if sys.stdout.isatty():
  print("\033[2J\033[H",end="")
 width=min(shutil.get_terminal_size((100,24)).columns,100)
 print(
  f"torrent-mgmnt — Maintenance — {title}"
  if title else "torrent-mgmnt — Maintenance"
 )
 print("-"*width)
 print()
 if body:
  print(body)
 print()
 print("-"*width)
 print(commands)
 print()


def maint_operator_module():
 """Persistent maintenance view; q always moves one level back."""
 view="main"
 notice=""
 dump_result="Select d to generate a new support dump file."
 selected_log=None

 while True:
  logs=_maint_logs()
  job_logs=[item for item in logs if item[0]=="queue"]
  if view=="main":
   title=""
   body=""
   commands="a=audit  c=clean  l=logs  d=dump  e=exit"
  elif view=="audit":
   title="Audit"
   body=_maint_capture(maint_audit)
   commands="a=audit  c=clean  l=logs  d=dump  r=refresh  q=back"
  elif view=="clean":
   title="Clean"
   body=_maint_capture(maint_clean,False)
   commands="x=execute clean  l=logs  d=dump  r=refresh  q=back"
  elif view=="logs":
   title="Logs"
   body=""
   commands="1=Gatekeeper Traffic  2=Blocked Peers  3=Job Logs  f=flush all  q=back"
  elif view=="job-logs":
   title="Job Logs"
   rows=[]
   for number,(_,path) in enumerate(job_logs,1):
    facts=_maint_file_facts(path)
    rows.append(
     f"{number:>3}  {path.name:<40} "
     f"{facts.get('size',0):>10} bytes  {facts.get('mtime','?')}"
    )
   body="\n".join(rows) or "No job logs found."
   commands="[number]=view log  r=refresh  q=back"
  elif view=="log":
   if selected_log is None or not selected_log.exists():
    view="logs"
    notice="Selected log is no longer available."
    continue
   title=f"Log — {selected_log.name}"
   body=_maint_log_view(selected_log)
   commands="f=flush this log  r=refresh  q=back"
  else:
   title="Support Dump"
   body=dump_result
   commands="a=audit  c=clean  l=logs  d=new dump  r=refresh  q=back"

  if notice:
   body=f"{notice}\n\n{body}"
   notice=""
  _maint_redraw(title,body,commands)

  try:
   choice=input("maint: ").strip().casefold()
  except (EOFError,KeyboardInterrupt):
   print()
   choice="e"

  if view=="main" and choice in {"e","exit"}:
   return "management"

  if choice in {"q","quit"}:
   if view=="log":
    view="job-logs"
   elif view=="job-logs":
    view="logs"
   elif view!="main":
    view="main"
   continue
  if choice in {"a","audit"}:
   view="audit"
   continue
  if choice in {"c","clean"}:
   view="clean"
   continue
  if choice in {"l","logs"}:
   view="logs"
   continue
  if choice in {"d","dump"}:
   dump_result=_maint_capture(maint_dump)
   view="dump"
   continue
  if choice in {"r","refresh",""}:
   continue

  if view=="logs" and choice=="1":
   gatekeeper_log_module()
   continue
  if view=="logs" and choice=="2":
   blocked_peers_log_module()
   continue
  if view=="logs" and choice=="3":
   view="job-logs"
   continue
  if view=="logs" and choice in {"f","flush"}:
   try:
    answer=input(
     f"Clear all {len(logs)} logs? Type flush to confirm: "
    ).strip()
   except (EOFError,KeyboardInterrupt):
    print()
    answer=""
   if answer.casefold()!="flush":
    notice="Flush all cancelled; no logs were cleared."
   else:
    cleared,failures=_maint_flush_all_logs()
    notice=f"Flushed {len(cleared)} log(s)."
    if failures:
     notice+=(
      f" Failed: {len(failures)} — "
      + "; ".join(f"{name}: {reason}" for name,reason in failures)
     )
   continue

  if view=="job-logs" and choice.isdigit():
   number=int(choice)
   if 1<=number<=len(job_logs):
    selected_log=job_logs[number-1][1]
    view="log"
   else:
    notice="Unknown log number."
   continue

  if view=="log" and choice in {"f","flush"}:
   try:
    answer=input(
     f"Clear {selected_log.name}? Type flush to confirm: "
    ).strip()
   except (EOFError,KeyboardInterrupt):
    print()
    answer=""
   if answer.casefold()!="flush":
    notice="Log flush cancelled; nothing was cleared."
   else:
    try:
     _maint_flush_log(selected_log)
     notice=f"Flushed log: {selected_log.name}"
    except Exception as exc:
     notice=f"Log flush failed: {exc}"
   continue

  if view=="clean" and choice in {"x","execute"}:
   try:
    answer=input(
     "Remove every displayed clean candidate? Type clean to confirm: "
    ).strip()
   except (EOFError,KeyboardInterrupt):
    print()
    answer=""
   if answer.casefold()!="clean":
    notice="Clean cancelled; nothing was removed."
   else:
    notice=_maint_capture(maint_clean,True) or "Clean completed."
   continue

  if view!="main":
   notice="Selection not available in this view."


def maint_module(argv):
 if not argv:
  if maint_operator_module()=="management":
   management_module()
  return

 parser=argparse.ArgumentParser(prog="torrent-mgmnt maint")
 sub=parser.add_subparsers(dest="action",required=True)
 sub.add_parser("audit",help="inspect maintenance state without changes")
 clean=sub.add_parser("clean",help="remove proven disposable owned state")
 clean.add_argument(
  "--apply",action="store_true",
  help="remove the displayed items",
 )
 sub.add_parser("dump",help="emit a read-only support dump")
 args=parser.parse_args(argv)
 if args.action=="audit":
  maint_audit()
 elif args.action=="clean":
  maint_clean(args.apply)
 else:
  maint_dump()


def _peer_parse_row_selection(values,count):
    selected=_parse_numeric_selection(values)

    invalid=[
        value
        for value in selected
        if value<1 or value>count
    ]

    if invalid:
        raise IndexError(
            " ".join(
                str(value)
                for value in invalid
            )
        )

    return selected


def _peer_global_rates_foreground():
    while True:
        print()

        try:
            choice=input(
                "Global rate control — "
                "d=download, u=upload, "
                "s=show, q=back: "
            ).strip()

        except (EOFError,KeyboardInterrupt):
            print()
            return

        if not choice:
            continue

        command=choice.casefold()

        if command in {"q","quit","back"}:
            return

        if command in {"s","show"}:
            try:
                raw=_peer_backend(
                    ["__mgmt-rates"]
                ).strip()

                rates=json.loads(raw)

                print()
                print("Global rate limits")
                print(
                    "Download: "
                    + (
                        human_size(
                            int(rates.get("down",0))
                        )
                        + "/s"
                        if int(
                            rates.get("down",0)
                        ) > 0
                        else "unlimited"
                    )
                )
                print(
                    "Upload:   "
                    + (
                        human_size(
                            int(rates.get("up",0))
                        )
                        + "/s"
                        if int(
                            rates.get("up",0)
                        ) > 0
                        else "unlimited"
                    )
                )

            except Exception as exc:
                print(exc)

            continue

        if command not in {
            "d","download",
            "u","upload",
        }:
            print(
                "Use d=download, u=upload, "
                "s=show, q=back."
            )
            continue

        direction=(
            "down"
            if command in {"d","download"}
            else "up"
        )

        try:
            rate=input(
                f"{direction.title()} rate "
                "(e.g. 500K, 2M, 0=unlimited): "
            ).strip()

        except (EOFError,KeyboardInterrupt):
            print()
            continue

        if not rate:
            continue

        result=subprocess.run(
            [
                str(
                    Path.home()
                    / ".local/bin/torrent-peers"
                ),
                "limit",
                direction,
                rate,
                "all",
            ],
            text=True,
        )

        if result.returncode != 0:
            print(
                "Rate update failed."
            )


def _peer_blocked_foreground():
    while True:
        try:
            raw=_peer_backend(
                ["__mgmt-blocks"]
            )

            ips=[
                line.strip()
                for line in raw.splitlines()
                if line.strip()
            ]

        except Exception as exc:
            print(
                f"Blocked-peer list unavailable — {exc}"
            )
            return

        print()
        print("Persistent globally blocked peers")
        print()

        if not ips:
            print("No blocked peers.")
        else:
            for number,ip in enumerate(
                ips,
                1
            ):
                print(
                    f"{number:>3}  {ip}"
                )

        print()

        try:
            choice=input(
                "u [IP]=unblock, "
                "r=refresh, q=back: "
            ).strip()

        except (EOFError,KeyboardInterrupt):
            print()
            return

        if not choice:
            continue

        parts=choice.split()
        command=parts[0].casefold()
        values=parts[1:]

        if command in {"q","quit","back"}:
            return

        if command in {"r","refresh"}:
            continue

        if command in {"u","unblock"}:
            if len(values)!=1:
                print(
                    "Usage: u IP"
                )
                continue

            try:
                raw=_peer_backend(
                    [
                        "__mgmt-unblock",
                        values[0],
                    ]
                ).strip()

            except Exception as exc:
                print(exc)
                continue

            parts=raw.split(
                "\t",
                1
            )

            if (
                len(parts)==2
                and parts[0]=="UNBLOCKED"
            ):
                print(
                    f"Unblocked: {parts[1]}"
                )
            else:
                print(raw)

            continue

        print(
            "u [IP]=unblock, "
            "r=refresh, q=back."
        )


def _peer_all_foreground():
    while True:
        try:
            raw=_peer_backend(
                ["all"],
                env={
                    "TORRENT_PEERS_MGMT_SNAPSHOT":"1"
                },
            )

        except Exception as exc:
            print(
                f"All-peer view unavailable — {exc}"
            )
            return

        marker="__TORRENT_PEERS_ROWS__"

        display=[]
        rows=None

        for line in raw.splitlines():
            if line.startswith(marker):
                try:
                    rows=json.loads(
                        line[len(marker):]
                    )
                except Exception:
                    rows=None
            else:
                display.append(line)

        if not isinstance(rows,list):
            print(
                "All-peer row map unavailable."
            )
            return

        print(
            "\n".join(display).rstrip()
        )
        print()

        try:
            choice=input(
                "b=block, bl=blocked, "
                "l=limits, p=peers, "
                "r=refresh, q=back: "
            ).strip()

        except (EOFError,KeyboardInterrupt):
            print()
            return

        if not choice:
            continue

        parts=choice.split()
        command=parts[0].casefold()
        values=parts[1:]

        if command in {"q","quit","back"}:
            return

        if command in {"r","refresh"}:
            continue

        if command in {
            "bl","blocked","blocks"
        }:
            if values:
                print(
                    "Use bl with no additional arguments."
                )
                continue

            _peer_blocked_foreground()
            continue

        if command in {
            "l","limit","limits"
        }:
            if values:
                print(
                    "Use l with no additional arguments."
                )
                continue

            _peer_global_rates_foreground()
            continue

        if command in {"p","peers"}:
            if values:
                print(
                    "Use p with no additional arguments."
                )
                continue

            try:
                target=input(
                    "Peer view — job ID, "
                    "or Enter for all: "
                ).strip()

            except (EOFError,KeyboardInterrupt):
                print()
                continue

            if not target:
                continue

            try:
                jid=int(target)
            except ValueError:
                print(
                    "Peer view accepts one "
                    "numeric job ID or Enter for all."
                )
                continue

            if jid<1:
                print(
                    "Peer view requires a positive job ID."
                )
                continue

            # Deliberately retain the existing p ID behavior.
            if not PEERS.is_file() or not os.access(PEERS,os.X_OK):
                raise SystemExit(
                    f"torrent-peers is not executable: {PEERS}"
                )
            os.execv(
                str(PEERS),
                [
                    str(PEERS),
                    str(jid),
                ],
            )

        if command in {"b","block"}:
            if not values:
                print(
                    "Usage: b ROW [ROW ...]"
                )
                continue

            try:
                selected=_peer_parse_row_selection(
                    values,
                    len(rows),
                )

            except ValueError:
                print(
                    "Block accepts rows and ranges, "
                    "e.g. b 1-7 12 18-22."
                )
                continue

            except IndexError as exc:
                print(
                    "Live peer row(s) unavailable: "
                    + str(exc)
                )
                continue

            ips=[]

            try:
                for number in selected:
                    row=rows[number-1]
                    ip=str(row["ip"])
                    ips.append(ip)

            except Exception:
                print(
                    "Displayed peer row map is invalid."
                )
                continue

            ips=list(
                dict.fromkeys(ips)
            )

            try:
                result=_peer_backend(
                    [
                        "__mgmt-block-many",
                        *ips,
                    ]
                )

            except Exception as exc:
                print(exc)
                continue

            blocked={
                line.split("\t",1)[1]
                for line in result.splitlines()
                if line.startswith("BLOCKED\t")
            }
            already={
                line.split("\t",1)[1]
                for line in result.splitlines()
                if line.startswith("ALREADY_BLOCKED\t")
            }
            failed={
                parts[1]:parts[2]
                for line in result.splitlines()
                if line.startswith("FAILED\t")
                for parts in [line.split("\t",2)]
            }

            for line in result.splitlines():
                if line.startswith("RETRY\t"):
                    parts=line.split("\t",3)
                    print(
                        "Backend unavailable — retrying "
                        f"{parts[2]} selected peer(s)..."
                    )

            successful=blocked|already
            disconnect_outcomes={}

            try:
                state=load_state()
                jobs={int(job["id"]):job for job in state.get("jobs",[])}
            except Exception:
                jobs={}

            for jid in dict.fromkeys(
                int(rows[number-1]["job"])
                for number in selected
                if str(rows[number-1].get("ip","")) in successful
            ):
                job_ips=list(dict.fromkeys(
                    str(rows[number-1]["ip"])
                    for number in selected
                    if int(rows[number-1]["job"])==jid
                    and str(rows[number-1].get("ip","")) in successful
                ))
                job=jobs.get(jid)
                raw=(
                    socket_query(
                        job,
                        "DROPPEERS " + ",".join(job_ips),
                        timeout=0.75,
                    )
                    if job is not None
                    else None
                )
                disconnect_outcomes[jid]=(
                    raw is not None
                    and raw.strip()=="OK\tQUEUED\tPEERS"
                )

            for number in selected:
                row=rows[number-1]
                ip=str(row.get("ip","?"))

                if ip in blocked or ip in already:
                    jid=int(row.get("job",0))
                    print(
                        f"Row {number}: blocked globally {ip} "
                        f"[Job {row.get('job','?')}] + live disconnect "
                        + (
                            "confirmed"
                            if disconnect_outcomes.get(jid,False)
                            else "not confirmed"
                        )
                    )

            if failed:
                print(f"Blocked:         {len(blocked)}")
                print(f"Already blocked: {len(already)}")
                print(f"Failed:          {len(failed)}")
                for ip,reason in failed.items():
                    print(f"  {ip} — {reason}")

            # The displayed rows are stale after enforcement.
            continue

        print(
            "Use b=block, bl=blocked, "
            "l=limits, p=peers, "
            "r=refresh, q=back."
        )


def main():
 # Maintenance dispatch precedes every normal startup mutation.  This is what
 # makes audit, the Clean review screen, and dump genuinely read-only.
 if len(sys.argv)>=2 and sys.argv[1].casefold()=="maint":
  maint_module(sys.argv[2:])
  return

 # Hidden control-plane entry point used by torrent-peers after
 # permanent BLOCK/UNBLOCK policy mutations.
 #
 # Foreground `f sync` remains available and unchanged.
 # Retire fast-resume files with no queue owner.
 # Ownership, never age, determines expiration.
 RESUME_DIR.mkdir(mode=0o700,parents=True,exist_ok=True)

 # Reconcile stale active ownership before any operator action.
 # Reconciliation is conservative: it never starts a worker.
 with locked_state() as startup_state:
  for startup_job in startup_state.get('jobs',[]):
   refresh(startup_job)

 try:
  resume_state=json.loads(STATE_FILE.read_text())
  resume_owned={
   int(x["id"])
   for x in resume_state.get("jobs",[])
   if "id" in x
  }
 except Exception:
  resume_owned=set()

 for resume_path in list(RESUME_DIR.glob("job-*.fastresume"))+list(RESUME_DIR.glob("job-*.fastresume.prev")):
  resume_match=re.fullmatch(
   r"job-([0-9]+)\.fastresume(?:\.prev)?",
   resume_path.name
  )

  if not resume_match:
   continue

  if int(resume_match.group(1)) in resume_owned:
   continue

  try:
   resume_path.unlink()
  except FileNotFoundError:
   pass
  except OSError:
   pass

 # -------------------------------------------------------
 # GLOBAL NETWORK CIRCUIT BREAKER
 #
 # Deliberate external controls:
 #
 #   torrent-mgmnt pause
 #   torrent-mgmnt resume
 #
 # This logic is intentionally DIRECT. There is no
 # pause/resume wrapper layer.
 # -------------------------------------------------------

 if len(sys.argv)==2 and sys.argv[1].casefold()=="pause":

  existing=network_pause_read()

  if existing["paused"]:
   print("Global torrent network: PAUSED")
   return

  targets=[]

  with locked_state() as state:
   for job in state["jobs"]:
    refresh(job)

    if alive(job):
     targets.append(int(job["id"]))

  # CLOSE CIRCUIT FIRST.
  #
  # No new worker may enter after this write.
  network_pause_write(True,targets)

  try:
   if targets:
    pause_many(targets)

  except BaseException:
   # Remain fail-closed.
   network_pause_write(True,targets)
   raise

  print(
   f"Global torrent network: PAUSED | "
   f"Workers stopped: {len(targets)}"
  )

  return


 if len(sys.argv)==2 and sys.argv[1].casefold()=="resume":

  current=network_pause_read()

  if not current["paused"]:
   print("Global torrent network: ACTIVE")
   return

  targets=list(
   dict.fromkeys(
    int(x)
    for x in current["jobs"]
   )
  )

  # OPEN CIRCUIT immediately before deliberate restoration.
  network_pause_write(False,targets)

  try:
   if targets:
    resume_many(targets)

  except BaseException:
   # A failed global resume must fail closed.
   network_pause_write(True,targets)
   raise

  network_pause_write(False,[])

  print(
   f"Global torrent network: ACTIVE | "
   f"Workers resumed: {len(targets)}"
  )

  return



 if (
  len(sys.argv) >= 2
  and sys.argv[1].casefold() in {"f","filter"}
 ):
  filter_control_direct(
   sys.argv[2:]
  )
  return

 if len(sys.argv) == 1:
  # Foreground Management is a persistent operator environment.
  #
  # Individual actions may use SystemExit internally to report
  # invalid IDs or other rejected operations. Those failures must
  # never terminate the foreground management session.
  while True:
   try:
    management_module()
    return

   except SystemExit as exc:
    code=exc.code

    if isinstance(code,str):
     message=code.strip()

     if message:
      print(message)

    elif code not in (None,0):
     print(
      "Action rejected."
     )

    print()
    continue

 if (
  len(sys.argv) >= 2
  and sys.argv[1] == "prune"
  and os.environ.get(
   "TORRENT_MGMNT_INTERNAL_PRUNE"
  ) != "1"
 ):
  raise SystemExit(
   "Prune is controlled from the Torrent Management Module. "
   "Run 'torrent-mgmnt' and select pr."
  )

 if (
