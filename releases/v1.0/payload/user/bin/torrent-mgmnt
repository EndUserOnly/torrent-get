def bar(done,size,width=18):
 pct=1.0 if size==0 else max(0.0,min(1.0,done/size)); filled=int(round(pct*width)); return '['+'█'*filled+'-'*(width-filled)+']',pct*100

def persist_file_priority(jid,native_index):
 native_index=int(native_index)

 with locked_state() as s:
  j=get_job(s,jid)
  if not j:
   raise SystemExit(f"Unknown queue job: {jid}")

  if not alive(j):
   raise SystemExit(
    f"Job [{jid}] is not active."
   )

  j["priority_file_index"]=native_index
  j["priority_applied_pid"]=None
  j.pop("sequence_order",None)
  j.pop("sequence_applied_pid",None)
  snapshot=json.loads(json.dumps(j))

 raw=socket_query(
  snapshot,
  "SEQUENCE "+str(native_index),
  timeout=10.0
 )

 if not raw:
  raise SystemExit("Live file-priority interface unavailable.")

 if raw.startswith("ERROR\t"):
  raise SystemExit(
   raw.strip().split("\t",1)[1]
  )

 if not raw.startswith("OK\tPRIORITY\t"):
  raise SystemExit(
   "Unexpected file-priority response."
  )

 with locked_state() as s:
  j=get_job(s,jid)
  if j and int(j.get("pid") or 0)==int(snapshot.get("pid") or 0):
   j["priority_applied_pid"]=int(snapshot["pid"])

 return raw.strip()

def clear_file_priority(jid,reset_worker=True):
 was_alive=False
 had_priority=False
 with locked_state() as s:
  j=get_job(s,jid)
  if not j:
   raise SystemExit(f"Unknown queue job: {jid}")
  was_alive=alive(j)
  had_priority=(
   j.get("priority_file_index") is not None
   or bool(j.get("sequence_order"))
  )
  j.pop("priority_file_index",None)
  j.pop("priority_applied_pid",None)
  j.pop("sequence_order",None)
  j.pop("sequence_applied_pid",None)

 # The worker's established single-file command atomically resets all
 # priorities before setting MAX, but has no separate reset command.
 # A controlled checkpoint/restart is therefore the only supported way
 # to restore every file to libtorrent's normal priority.
 if reset_worker and was_alive and had_priority:
  pause_many([jid])
  resume(jid)


def contents(jid):
 while _contents_view(jid):
  pass


def _contents_view(jid):
 s=state_refreshed(); j=get_job(s,jid)
 if not j:raise SystemExit(f'Unknown queue job: {jid}')
 if not alive(j):raise SystemExit(f"Job [{jid}] is not active. Resume it before requesting live contents progress.")
 raw=socket_query(j,'FILES',timeout=10.0)
 if not raw:raise SystemExit('Live contents interface unavailable.')
 if raw.startswith('ERROR\t'):
  reason=raw.strip().split('\t',1)[1]
  if reason.casefold()=='metadata unavailable':
   raise SystemExit('Metadata is not READY yet.')
  raise SystemExit(reason)

 # FILES is emitted by the worker in native libtorrent file-index
 # order. Preserve that index before presentation sorting.
 files=[]
 for line in raw.splitlines():
  x=line.split('\t',3)
  if len(x)==4 and x[0]=='FILE':
   try:
    native_index=len(files)
    files.append(
     (
      native_index,
      x[3],
      int(x[1]),
      int(x[2])
     )
    )
   except:
    pass

 if not files:raise SystemExit('Live contents manifest is empty.')

 st=live_status(j)
 total_size=sum(size for _,_,size,_ in files)
 total_done=sum(done for _,_,_,done in files)
 progress=(
  st['progress']
  if st
  else (1.0 if total_size==0 else total_done/total_size)
 )
 torrent_size=st['size'] if st else total_size

 folders=defaultdict(lambda:[0,0])
 for _,path,size,done in files:
  parts=Path(path).parts
  for i in range(1,len(parts)):
   folder=str(Path(*parts[:i]))+'/'
   folders[folder][0]+=size
   folders[folder][1]+=done

 rows=[]
 for folder,(size,done) in folders.items():
  rows.append((folder,size,done,'DIR',None))

 for native_index,path,size,done in files:
  rows.append(
   (
    path,
    size,
    done,
    'FILE',
    native_index
   )
  )

 rows.sort(
  key=lambda r:(
   r[0].lower(),
   0 if r[3]=='DIR' else 1
  )
 )

 selected_native=j.get("priority_file_index")
 selected_file=next(
  (
   row for row in rows
   if row[3]=='FILE' and row[4]==selected_native
  ),
  None
 )

 # A priority selection is never handed on to another file. Once its
 # verified size is complete, remove the persisted designation.
 if (
  selected_file is not None
  and selected_file[1]>=0
  and selected_file[2]>=selected_file[1]
 ):
  clear_file_priority(jid,reset_worker=False)
  selected_native=None

 print(f"\nJob [{j['id']}] — {j['name']}")
 print(f"Magnet #:  {j.get('infohash') or '--'}")
 print(f"Progress: {progress*100:.1f}% of {human_size(torrent_size)}")
 print(
  "Download: "
  + (
   human_size(st["down"]) + "/s"
   if st
   else "--"
  )
 )
 print('\n Contents (verified piece progress)')
 print('-'*118)
 print(
  f"{'#':>3} {'Pri':<3} "
  f"{'Progress':<27} "
  f"{'Done / Size':>24}  "
  f"Type  Path"
 )
 print('-'*118)

 display_indices=[]
 record=0

 for path,size,done,kind,native_index in rows:
  b,pct=bar(done,size)
  amount=f"{human_size(done)} / {human_size(size)}"

  if kind=='FILE':
   record+=1
   rec=f"{record:>3}"
   display_indices.append(native_index)
  else:
   rec="   "

  priority=(
   "MAX"
   if kind=='FILE' and native_index==selected_native
   else ""
  )

  print(
   f"{rec} {priority:<3} "
   f"{b} {pct:6.1f}% "
   f"{amount:>24}  "
   f"{kind:<4}  "
   f"{path}"
  )

 print()

 # Preserve non-interactive `torrent-mgmnt contents ...` behavior.
 # Selector is exposed by the established interactive contents view.
 if os.environ.get(
  "TORRENT_MGMNT_INTERNAL_CONTENTS"
 )!="1":
  return

 while True:
  try:
   choice=input(
    "r=refresh, s [record]=select priority file, "
    "c=clear priority, p=peers, q=back: "
   ).strip()
  except (EOFError,KeyboardInterrupt):
   print()
   return

  if not choice:
   continue

  if choice.casefold() in {"q","quit","back"}:
   return

  if choice.casefold() in {"r","refresh"}:
   return True

  if choice.casefold() in {"p","peers"}:
   env=os.environ.copy()
   env["TORRENT_PEERS_RETURN_TO_CONTENTS"]="1"
   subprocess.run(
    [str(HOME/".local/bin/torrent-peers"),str(jid)],
    env=env,
    check=False,
   )
   return True

  if choice.casefold() in {"c","clear"}:
   clear_file_priority(jid)
   print("File priority cleared.")
   return True

  parts=choice.split()

  if len(parts)!=2 or parts[0].casefold()!="s":
   print("Use r, s [record], c, p, or q.")
   continue

  try:
   selected=int(parts[1])
  except ValueError:
   print("Contents record must be numeric.")
   continue

  if selected<1 or selected>len(display_indices):
   print(
    f"Contents record must be 1-{len(display_indices)}."
   )
   continue

  selected_native=display_indices[selected-1]
  selected_row=next(
   row for row in rows
   if row[3]=='FILE' and row[4]==selected_native
  )

  if selected_row[2]>=selected_row[1]:
   print(f"Record {selected} is already complete.")
   continue

  try:
   persist_file_priority(jid,selected_native)
  except SystemExit as exc:
   print(exc)
   continue

  print(f"Record {selected} selected for maximum priority.")
  return True

def remove_many(ids,delete_payload=False):
 ids=validate_job_ids(ids)

 if not ids:
  raise SystemExit(
   'remove requires one or more job IDs'
  )

 removed=[]
 failed=[]
 jobs={}
 original_states={}
 active_ids=set()

 # ---------------------------------------------------------
 # ONE queue transaction:
 #
 #   - resolve every requested job
 #   - refresh each once
 #   - snapshot ownership
 #   - advertise REMOVING for live workers
 #
 # No repeated state acquisition per job.
 # ---------------------------------------------------------
 with locked_state() as state:

  for jid in ids:
   job=get_job(state,jid)

   if not job:
    failed.append(jid)

    print(
     f"Job [{jid}]: REMOVE FAILED — "
     "queue record unavailable."
    )

    continue

   refresh(job)

   original_states[jid]=job.get(
    'state'
   )

   is_live=alive(job)
   jobs[jid]=dict(job)

   if is_live:
    active_ids.add(jid)
    job['state']='REMOVING'

 # Nothing valid to process.
 if not jobs:
  if len(ids)>1:
   print()
   print(
    f"Removed: 0 | Failed: {len(failed)}"
   )

  return

 # ---------------------------------------------------------
 # Stop all queue-owned workers in ONE systemctl operation.
 #
 # Existing remove semantics do not treat a systemctl return
 # code as removal authority; teardown verification remains
 # in the normal lifecycle below.
 # ---------------------------------------------------------
 units=[]

 for jid,job in jobs.items():
  if jid not in active_ids:
   continue

  units.append(
   job.get('systemd_unit')
   or f'torrent-worker-{jid}.service'
  )

 if units:
  subprocess.run(
   [
    'systemctl',
    '--user',
    'stop',
    *units,
   ],
   stdout=subprocess.DEVNULL,
   stderr=subprocess.DEVNULL,
   check=False
  )

 successful=set()

 # ---------------------------------------------------------
 # Per-job filesystem/security teardown.
 #
 # No queue-state locks occur in this loop.
 # ---------------------------------------------------------
 for jid in ids:

  job=jobs.get(jid)

  if job is None:
   continue

  payload_deleted=not delete_payload
  payload_reason=None

  # Resolve payload only when deletion was actually requested.
  if delete_payload:
   payload=safe_target(job)

   if payload is None:
    payload_reason="unsafe payload path"

   else:
    try:
     if (
      payload.is_symlink()
      or payload.is_file()
     ):
      payload.unlink()
      payload_deleted=True

     elif payload.is_dir():
      shutil.rmtree(payload)
      payload_deleted=True

     elif not payload.exists():
      payload_deleted=True

     else:
      payload_reason=(
       "unsupported payload filesystem object"
      )

    except Exception as exc:
     payload_reason=str(exc)

  # Requested payload deletion is transactional with removal:
  # failure retains queue identity/recovery ownership.
  if not payload_deleted:
   reason=(
    payload_reason
    or "payload deletion failed"
   )

   failed.append(jid)

   print(
    f"Job [{jid}]: NOT REMOVED — "
    f"payload deletion FAILED ({reason}); "
    "recovery state retained."
   )

   continue

  resume_file=(
   RESUME_DIR
   / f"job-{jid}.fastresume"
  )

  try:
   resume_file.unlink()

  except FileNotFoundError:
   pass

  except OSError as exc:
   failed.append(jid)

   print(
    f"Job [{jid}]: NOT REMOVED — "
    "unable to retire fast-resume "
    f"({exc})."
   )

   continue

  try:
   retire_metadata_approval(job)

  except Exception as exc:
   failed.append(jid)

   print(
    f"Job [{jid}]: NOT REMOVED — "
    "unable to retire metadata approval "
    f"({exc})."
   )

   continue

  successful.add(jid)
  removed.append(jid)

 # ---------------------------------------------------------
 # ONE final queue transaction:
 #
 #   - delete successful identities together
 #   - restore unsuccessful jobs from REMOVING
 #
 # This replaces one queue rewrite per job.
 # ---------------------------------------------------------
 with locked_state() as state:

  if successful:
   state['jobs']=[
    job
    for job in state['jobs']
    if int(job['id']) not in successful
   ]

  for jid in failed:
   current=get_job(state,jid)

   if (
    current
    and current.get('state')=='REMOVING'
   ):
    current['state']=original_states.get(
     jid,
     'STOPPED'
    )

 # Operator output remains per requested job.
 for jid in ids:

  if jid not in successful:
   continue

  if delete_payload:
   print(
    f"Job [{jid}]: REMOVED — "
    "payload deleted."
   )
  else:
   print(
    f"Job [{jid}]: REMOVED — "
    "payload retained."
   )

 if len(ids)>1:
  print()
  print(
   f"Removed: {len(removed)} | "
   f"Failed: {len(failed)}"
  )


def prune(jid=None):
 # A queue record must never relinquish ownership of a live worker.
 inactive={'EXITED','STOPPED','ORPHANED','MISSING','PAUSED'}

 with locked_state() as s:
  for j in s['jobs']:
   refresh(j)

  if jid is None:
   targets=[
    int(j['id'])
    for j in s['jobs']
    if j.get('state') in inactive
   ]
  else:
   j=get_job(s,jid)

   if not j:
    raise SystemExit(f'Unknown queue job: {jid}')

   if j.get('state') not in inactive:
    raise SystemExit(
     f"Job [{jid}] is {j.get('state')}; "
     "only inactive records can be pruned."
    )

   targets=[int(jid)]

 # Snapshot queue identities before permanent teardown.
 with locked_state() as state:
  target_set=set(
   int(x)
   for x in targets
  )

  retiring_jobs={
   int(job['id']):dict(job)
   for job in state['jobs']
   if int(job['id']) in target_set
  }

 # Stop ownership BEFORE deleting any record.
 for target in targets:
  unit=f'torrent-worker-{target}.service'

  subprocess.run(
   ['systemctl','--user','stop',unit],
   stdout=subprocess.DEVNULL,
   stderr=subprocess.DEVNULL,
   check=False
  )

 # Only after shutdown may recovery, approval, and queue
 # identities disappear.
 for target in targets:
  target=int(target)

  resume_file=RESUME_DIR/f"job-{target}.fastresume"

  try:
   resume_file.unlink()
  except FileNotFoundError:
   pass
  except OSError as exc:
   raise SystemExit(
    f"Unable to retire fast-resume for job [{target}]: {exc}"
   )

  retiring_job=retiring_jobs.get(target)

  if retiring_job is None:
   raise SystemExit(
    f"Unable to retire metadata approval for job [{target}]: "
    "queue identity unavailable"
   )

  try:
   retire_metadata_approval(
    retiring_job
   )
  except Exception as exc:
   raise SystemExit(
    f"Unable to retire metadata approval for job [{target}]: {exc}"
   )

 with locked_state() as s:
  before=len(s['jobs'])

  if jid is None:
   target_set=set(targets)
   s['jobs']=[
    j for j in s['jobs']
    if int(j['id']) not in target_set
   ]

   print(
    f"Pruned {before-len(s['jobs'])} inactive queue record(s)."
   )
  else:
   s['jobs']=[
    j for j in s['jobs']
    if int(j['id']) != int(jid)
   ]

   print(
    f"Pruned queue record [{jid}]. "
    "Payload and logs were not touched."
   )


def validate_job_ids(ids):
 if not ids:return []
 ids=list(dict.fromkeys(int(x) for x in ids))
 with locked_state() as s:
  known={int(j['id']) for j in s['jobs']}
 missing=[jid for jid in ids if jid not in known]
 if missing:
  raise SystemExit(
   'Unknown queue job(s): ' + ' '.join(str(x) for x in missing)
  )
 return ids



def network_pause_read():
 if not NETWORK_PAUSE_STATE.exists():
  return {"paused":False,"jobs":[]}

 try:
  raw=json.loads(NETWORK_PAUSE_STATE.read_text())

  return {
   "paused":bool(raw.get("paused",False)),
   "jobs":[int(x) for x in raw.get("jobs",[])]
  }

 except Exception:
  # Invalid breaker state fails closed.
  return {"paused":True,"jobs":[]}


def network_pause_write(paused,jobs):
 NETWORK_PAUSE_STATE.parent.mkdir(
  parents=True,
  exist_ok=True
 )

 tmp=NETWORK_PAUSE_STATE.with_name(
  NETWORK_PAUSE_STATE.name+".tmp"
 )

 tmp.write_text(
  json.dumps(
   {
    "paused":bool(paused),
    "jobs":[int(x) for x in jobs]
   },
   indent=2,
   sort_keys=True
  )+"\n"
 )

 os.replace(tmp,NETWORK_PAUSE_STATE)


def network_paused():
 return bool(network_pause_read()["paused"])


def pause_many(ids):
 ids=validate_job_ids(ids)

 # No IDs means all currently active jobs.
 if not ids:
  with locked_state() as state:
   targets=[]

   for job in state['jobs']:
    refresh(job)

    if alive(job):
     targets.append(int(job['id']))

  ids=targets

 if not ids:
  print('No running jobs to pause.')
  return

 paused=[]

 for jid in ids:

  with locked_state() as state:
   job=get_job(state,jid)

   if not job:
    raise SystemExit(f'Unknown queue job: {jid}')

   refresh(job)

   if not alive(job):
    if job.get('state') in {'PAUSED','STOPPED'}:
     # Normalize any legacy retained state.
     job['state']='PAUSED'
     paused.append(jid)
     continue

    raise SystemExit(
     f"Job [{jid}] is {job.get('state')}; "
     "only running jobs can be paused."
    )

   unit=(
    job.get('systemd_unit')
    or f'torrent-worker-{jid}.service'
   )

   job['state']='PAUSING'
   checkpoint_before=int(job.get('checkpoint_generation') or 0)

  # Direct worker shutdown.
  subprocess.run(
   ['systemctl','--user','stop',unit],
   stdout=subprocess.DEVNULL,
   stderr=subprocess.DEVNULL,
   check=False
  )

  with locked_state() as state:
   job=get_job(state,jid)

   if not job:
    raise SystemExit(
     f'Job [{jid}] disappeared during pause.'
    )

   refresh(job)
   if alive(job):
    job['state']='RECOVERABLE'
    job['recovery_reason']='worker did not stop within systemd timeout'
   elif (job.get('checkpoint_valid') and
         int(job.get('checkpoint_generation') or 0)>checkpoint_before):
    job['state']='PAUSED'
    job.pop('recovery_reason',None)
   else:
    job['state']='RECOVERABLE'
    job['recovery_reason']='no durable resume checkpoint confirmed'
   job['last_checked']=int(time.time())

  if job.get('state')=='PAUSED':paused.append(jid)
  else:print(f"Job [{jid}] stopped in RECOVERABLE state; no final checkpoint was confirmed.")

 if len(paused)==1:
  print(
   f"Job [{paused[0]}] paused. "
   "Payload retained."
  )
 else:
  joined=' '.join(str(x) for x in paused)

  print(
   f"SYSTEM PAUSED — {len(paused)} job(s) "
   f"[{joined}]. Payloads retained."
  )

def resume_many(ids):
 if not ids:
  resume_all(); return
 for jid in validate_job_ids(ids):
  resume(jid)


